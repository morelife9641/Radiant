.wb {
  padding-top: var(--space-2);
  padding-bottom: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.wb__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.wb__empty {
  min-height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-white);
  box-shadow: var(--shadow-soft);
  color: var(--color-graphite);
  font-size: 28rpx;
}
.wb__item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.wb__item--press { transform: scale(0.98); }

.wb__cover {
  width: 84rpx;
  height: 112rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-white);
  font-size: 36rpx;
  font-weight: 800;
  overflow: hidden;
  flex-shrink: 0;
}
.wb__cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.wb__name { font-size: 30rpx; font-weight: 600; color: var(--color-ink); }

.wb__badge {
  padding: 6rpx 16rpx;
  background: var(--color-bg);
  color: var(--color-graphite);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.wb__badge.is-active {
  background: var(--color-primary-light);
  color: var(--color-primary-deep);
}
