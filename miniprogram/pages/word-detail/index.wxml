<view class="page detail {{fromLearn ? 'detail--learn' : ''}}" wx:if="{{word}}" style="padding-top: {{navTopPx}}px">
  <study-hero
    word="{{word.word}}"
    phonetic="{{word.phonetic}}"
    translations="{{headingTranslations}}"
    show-heading="{{true}}"
    show-progress="{{false}}"
    show-recovery="{{recovery ? true : false}}"
    recovery-passed="{{recovery ? recovery.passed : 0}}"
    bind:back="onBack"
    bind:play="onPlay"
  >
      <view slot="actions" class="detail__state-actions">
        <view
          class="detail__icon-button {{isFavorite ? 'is-active' : ''}}"
          bindtap="onToggleFavorite"
          aria-label="{{isFavorite ? '取消收藏' : '收藏'}}"
        >
          <image class="detail__action-icon" src="{{isFavorite ? '/assets/icons/star-filled.svg' : '/assets/icons/star-outline.svg'}}" mode="aspectFit" />
        </view>
        <view
          wx:if="{{!isIgnored}}"
          class="detail__icon-button is-danger"
          bindtap="onIgnoreWord"
          aria-label="删除"
        >
          <image class="detail__action-icon" src="/assets/icons/trash.svg" mode="aspectFit" />
        </view>
        <view
          wx:else
          class="detail__icon-button is-restore"
          bindtap="onRestoreWord"
          aria-label="恢复学习"
        >
          <text class="detail__icon-restore">↺</text>
        </view>
      </view>
  </study-hero>

  <view class="detail__tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="detail__tab {{activeTab === item.key ? 'detail__tab--active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onSwitchTab"
      hover-class="detail__tab--press"
      hover-stay-time="70"
    >
      <text class="detail__tab-label">{{item.label}}</text>
    </view>
  </view>

  <scroll-view class="detail__body {{fromLearn ? 'detail__body--learn' : ''}}" scroll-y="{{true}}" enhanced show-scrollbar="{{false}}">
  <view wx:if="{{activeTab === 'basic'}}" class="detail__panel">
    <view wx:if="{{learningContent && learningContent.hasShortDefinition}}" class="detail__short-definition card">
      <text class="detail__section-title">英文短释</text>
      <view
        class="detail__short-definition-row {{shortDefinitionRevealed ? 'is-expanded' : ''}}"
        bindtap="onToggleShortDefinition"
        hover-class="detail__short-definition-row--press"
        hover-stay-time="80"
      >
        <text class="detail__short-definition-en">{{learningContent.shortDefinitionEn}}</text>
      </view>
      <text
        wx:if="{{shortDefinitionRevealed && learningContent.shortDefinitionZh}}"
        class="detail__short-definition-zh"
      >{{learningContent.shortDefinitionZh}}</text>
    </view>

    <view wx:if="{{word.inflections && word.inflections.length}}" class="detail__inflections card">
      <text class="detail__section-title">词形变化</text>
      <view class="detail__inflection-list">
        <view wx:for="{{word.inflections}}" wx:key="type" class="detail__inflection-item">
          <text class="detail__inflection-form">{{item.form}}</text>
          <text class="detail__inflection-label">{{item.labelZh}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{learningContent && learningContent.hasCollocations}}" class="detail__collocation-card card">
      <view class="detail__collocation-head">
        <text class="detail__section-title">常用搭配</text>
      </view>
      <view class="detail__collocation-list">
        <view
          wx:for="{{learningContent.collocations}}"
          wx:key="text"
          wx:for-item="item"
          wx:for-index="collocationIdx"
          class="detail__collocation-row {{expandedCollocationIndexes[collocationIdx] ? 'is-expanded' : ''}}"
          data-index="{{collocationIdx}}"
          catchtap="onToggleCollocation"
        >
          <view class="detail__collocation-copy">
            <text class="detail__collocation-main">{{item.text}}</text>
            <text wx:if="{{expandedCollocationIndexes[collocationIdx] && item.translationZh}}" class="detail__collocation-sub">{{item.translationZh}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{examplesLoading || featuredExample}}" class="detail__source-card card" bindtap="onOpenCorpus">
      <view class="detail__source-head">
        <text class="detail__section-title">阅读出处</text>
      </view>
      <view wx:if="{{featuredExample}}" class="detail__source-body">
        <view class="detail__token-line detail__example-en">
          <view
            wx:for="{{featuredExample.tokens}}"
            wx:key="index"
            wx:for-item="token"
            class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
            data-word="{{token.value}}"
            catchtap="onSearchToken"
          >{{token.text}}</view>
        </view>
        <text wx:if="{{featuredExample.translationZh}}" class="detail__example-zh muted">{{featuredExample.translationZh}}</text>
        <text wx:if="{{featuredExample.sourceLabel}}" class="detail__example-source muted">{{featuredExample.sourceLabel}}</text>
      </view>
      <view class="detail__source-footer">
        <text class="detail__source-action">{{examplesLoading ? '正在查找原文' : '查看全部出处'}}</text>
      </view>
    </view>

    <view wx:if="{{(learningLoading && !learningContent) || (examplesLoading && !featuredExample)}}" class="detail__basic-loading">
      <r-loading compact title="{{learningLoading ? '正在补充搭配和学习内容' : '正在查找阅读出处'}}" />
    </view>
  </view>

  <view hidden="{{activeTab !== 'corpus'}}" class="detail__panel">
    <view class="detail__examples card">
      <view class="row-between">
        <text class="detail__section-title">{{examplesTitle}}</text>
        <text wx:if="{{examplesLoading}}" class="caption muted">加载中…</text>
      </view>

      <view wx:if="{{!examplesLoading && !examples.length}}" class="detail__empty">
        <text class="detail__empty-copy">{{examplesError ? '请确认云函数已上传，或稍后再试' : '这个词目前没有匹配到可展示的原文例句'}}</text>
      </view>

      <view wx:for="{{examples}}" wx:key="id" wx:for-item="example" class="detail__example-card">
        <view class="detail__example-main">
          <image wx:if="{{example.topicCover.image}}" class="detail__example-cover" src="{{example.topicCover.image}}" mode="aspectFill" />
          <view class="detail__example-copy">
            <view class="detail__token-line">
              <view
                wx:for="{{example.tokens}}"
                wx:key="index"
                wx:for-item="token"
                class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
                data-word="{{token.value}}"
                catchtap="onSearchToken"
              >{{token.text}}</view>
            </view>
            <text wx:if="{{example.translationZh}}" class="detail__example-zh">{{example.translationZh}}</text>
            <text class="detail__example-source muted">{{example.sourceLabel}}</text>
          </view>
        </view>
        <view wx:if="{{example.audioUrl}}" class="detail__example-play" data-url="{{example.audioUrl}}" bindtap="onPlayExample" aria-label="播放例句">
          <view class="detail__example-play-icon"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'learning'}}" class="detail__panel">
    <view wx:if="{{learningLoading}}" class="detail__empty card">
      <r-loading compact title="正在读取构词、搭配和语法模式" />
    </view>
    <view wx:if="{{!learningLoading && learningError}}" class="detail__empty card">
      <text class="detail__empty-copy">请确认 wordbook-fetch 云函数已重新上传，或稍后再试</text>
    </view>
    <view wx:if="{{!learningLoading && !learningError && !learningContent}}" class="detail__empty card">
      <text class="detail__empty-copy">这个词目前只有基础释义和原文例句</text>
    </view>

    <view wx:if="{{!learningLoading && learningContent && learningContent.hasProfile}}" class="detail__learn-card card">
      <view class="detail__learn-head">
        <text class="detail__section-title">考试画像</text>
        <view class="detail__learn-badges">
          <text wx:if="{{learningContent.occurrenceText}}" class="detail__learn-badge">{{learningContent.occurrenceText}}</text>
          <text wx:if="{{learningContent.priorityText}}" class="detail__learn-badge">{{learningContent.priorityText}}</text>
          <text wx:if="{{learningContent.writingText}}" class="detail__learn-badge">{{learningContent.writingText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!learningLoading && learningContent && learningContent.hasMorphology}}" class="detail__learn-card card">
      <text class="detail__section-title">构词</text>
      <text wx:if="{{learningContent.morphology.explanationZh}}" class="detail__learn-text">{{learningContent.morphology.explanationZh}}</text>
      <view wx:if="{{learningContent.morphology.segments.length}}" class="detail__segment-list">
        <view wx:for="{{learningContent.morphology.segments}}" wx:key="form" wx:for-item="seg" class="detail__segment">
          <text class="detail__segment-form">{{seg.form}}</text>
          <text class="detail__segment-type">{{seg.type}}</text>
          <text class="detail__segment-meaning">{{seg.meaningText}}</text>
        </view>
      </view>
      <view wx:if="{{learningContent.morphology.relatedWords.length}}" class="detail__related-list">
        <text class="detail__mini-title">相关词</text>
        <view wx:for="{{learningContent.morphology.relatedWords}}" wx:key="word" wx:for-item="rw" class="detail__related-item">
          <text class="detail__related-word">{{rw.word}}</text>
          <text class="detail__related-copy">{{rw.displayText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!learningLoading && learningContent && learningContent.hasGrammarPatterns}}" class="detail__learn-card card">
      <text class="detail__section-title">语法模式</text>
      <view wx:for="{{learningContent.grammarPatterns}}" wx:key="pattern" wx:for-item="item" class="detail__pattern">
        <text class="detail__pattern-title">{{item.pattern}}</text>
        <view wx:if="{{item.exampleEn}}" class="detail__token-line detail__example-en">
          <view
            wx:for="{{item.exampleTokens}}"
            wx:key="index"
            wx:for-item="token"
            class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
            data-word="{{token.value}}"
            catchtap="onSearchToken"
          >{{token.text}}</view>
        </view>
        <text wx:if="{{item.exampleZh}}" class="detail__example-zh muted">{{item.exampleZh}}</text>
      </view>
    </view>

    <view wx:if="{{!learningLoading && learningContent && learningContent.hasCommonErrors}}" class="detail__learn-card card">
      <text class="detail__section-title">易错点</text>
      <view wx:for="{{learningContent.commonErrors}}" wx:key="title" wx:for-item="item" class="detail__error-item">
        <text class="detail__error-title">{{item.titleText}}</text>
        <text class="detail__learn-text">{{item.bodyText}}</text>
      </view>
    </view>
  </view>

  <view
    wx:if="{{(activeTab === 'synonyms' || activeTab === 'antonyms' || activeTab === 'confusing') && relationSenseOptions.length > 1}}"
    class="detail__sense-filter"
  >
    <view
      wx:for="{{relationSenseOptions}}"
      wx:key="senseId"
      wx:for-item="senseOption"
      class="detail__sense-filter-item {{currentSenseId === senseOption.senseId ? 'is-active' : ''}}"
      data-sense="{{senseOption.senseId}}"
      bindtap="onSelectRelationSense"
      hover-class="detail__sense-filter-item--press"
      hover-stay-time="70"
    >
      <text class="detail__sense-filter-pos">{{senseOption.posLabel}}</text>
      <text class="detail__sense-filter-translation">{{senseOption.translation}}</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 'synonyms'}}" class="detail__panel">
    <view wx:if="{{relationsLoading}}" class="detail__empty card">
      <r-loading compact title="正在读取近义词和辨析内容" />
    </view>
    <view wx:if="{{!relationsLoading && relationsError}}" class="detail__empty card">
      <text class="detail__empty-copy">请确认 wordbook-fetch 云函数已重新上传，或稍后再试</text>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && relationSynonyms.length}}" class="detail__sense card">
      <view wx:for="{{relationSynonyms}}" wx:key="_id" wx:for-item="rel" class="detail__relation">
        <view class="detail__relation-head" data-word="{{rel.word}}" bindtap="onOpenRelationWord">
          <view class="detail__relation-main">
            <text class="detail__syn-word">{{rel.word}}</text>
            <text class="detail__relation-type">{{rel.typeLabel}}</text>
          </view>
          <text wx:if="{{rel.strengthText}}" class="detail__syn-toggle muted">{{rel.strengthText}}</text>
        </view>
        <text wx:if="{{rel.explanation}}" class="detail__relation-text">{{rel.explanation}}</text>
        <view wx:if="{{rel.exampleEn}}" class="detail__syn-example">
          <view class="detail__token-line">
            <view
              wx:for="{{rel.exampleEnTokens}}"
              wx:key="index"
              wx:for-item="token"
              class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
              data-word="{{token.value}}"
              catchtap="onSearchToken"
            >{{token.text}}</view>
          </view>
          <text wx:if="{{rel.exampleZh}}" class="detail__example-zh muted">{{rel.exampleZh}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && !relationSynonyms.length && hasSynonyms}}" wx:for="{{word.senses}}" wx:key="index" wx:for-item="sense" wx:for-index="senseIdx">
      <view wx:if="{{sense.synonyms && sense.synonyms.length}}" class="detail__sense card">
        <view class="detail__sense-head">
          <text class="detail__pos">{{sense.posLabel || sense.pos}}</text>
          <view class="detail__translation">
            <text wx:for="{{sense.translationLines}}" wx:key="index" class="detail__translation-line">{{item}}</text>
          </view>
        </view>
        <view wx:for="{{sense.synonyms}}" wx:key="word" wx:for-item="syn" wx:for-index="synIdx" class="detail__syn">
          <view class="detail__syn-head" data-sense="{{senseIdx}}" data-syn="{{synIdx}}" bindtap="onToggleSyn">
            <text class="detail__syn-word">{{syn.word}}</text>
            <text class="detail__syn-toggle muted">{{expandedKey === senseIdx + '-' + synIdx ? '收起' : '展开'}}</text>
          </view>
          <view wx:if="{{expandedKey === senseIdx + '-' + synIdx}}" class="detail__syn-body">
            <view class="detail__token-line detail__syn-nuance">
              <view
                wx:for="{{syn.nuanceTokens}}"
                wx:key="index"
                wx:for-item="token"
                class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
                data-word="{{token.value}}"
                catchtap="onSearchToken"
              >{{token.text}}</view>
            </view>
            <view class="detail__syn-example">
              <view class="detail__token-line">
                <view
                  wx:for="{{syn.exampleTokens}}"
                  wx:key="index"
                  wx:for-item="token"
                  class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
                  data-word="{{token.value}}"
                  catchtap="onSearchToken"
                >{{token.text}}</view>
              </view>
              <text class="detail__example-zh muted">{{syn.example_zh}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{!relationsLoading && !relationsError && !relationSynonyms.length && !hasSynonyms}}" class="detail__empty card">
      <text class="detail__empty-copy">这个词暂时没有人工确认的近义关系</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 'antonyms'}}" class="detail__panel">
    <view wx:if="{{relationsLoading}}" class="detail__empty card">
      <r-loading compact title="正在检查这个词是否有反义词" />
    </view>
    <view wx:if="{{!relationsLoading && relationsError}}" class="detail__empty card">
      <text class="detail__empty-copy">请确认 wordbook-fetch 云函数已重新上传，或稍后再试</text>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && relationAntonyms.length}}" class="detail__sense card">
      <view wx:for="{{relationAntonyms}}" wx:key="_id" wx:for-item="rel" class="detail__relation">
        <view class="detail__relation-head" data-word="{{rel.word}}" bindtap="onOpenRelationWord">
          <view class="detail__relation-main">
            <text class="detail__syn-word">{{rel.word}}</text>
            <text class="detail__relation-type">{{rel.typeLabel}}</text>
          </view>
          <text wx:if="{{rel.strengthText}}" class="detail__syn-toggle muted">{{rel.strengthText}}</text>
        </view>
        <text wx:if="{{rel.explanation}}" class="detail__relation-text">{{rel.explanation}}</text>
      </view>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && !relationAntonyms.length && hasAntonyms}}" class="detail__sense card">
      <text class="detail__section-title">反义词</text>
      <view class="detail__antonyms">
        <r-tag wx:for="{{antonyms}}" wx:key="*this" wx:for-item="ant" text="{{ant}}" />
      </view>
    </view>
    <view wx:if="{{!relationsLoading && !relationsError && !relationAntonyms.length && !hasAntonyms}}" class="detail__empty card">
      <text class="detail__empty-copy">这个词暂时没有可展示的反义关系</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 'confusing'}}" class="detail__panel">
    <view wx:if="{{relationsLoading}}" class="detail__empty card">
      <r-loading compact title="正在读取相近词和易混词" />
    </view>
    <view wx:if="{{!relationsLoading && relationsError}}" class="detail__empty card">
      <text class="detail__empty-copy">请确认 wordbook-fetch 云函数已重新上传，或稍后再试</text>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && relationConfusing.length}}" class="detail__relation-list">
      <view wx:for="{{relationConfusing}}" wx:key="_id" wx:for-item="rel" class="detail__relation-card">
        <view class="detail__relation-top">
          <view class="detail__relation-pair" data-word="{{rel.word}}" bindtap="onOpenRelationWord">
            <text class="detail__relation-current">{{word.word}}</text>
            <image class="detail__relation-arrow" src="/assets/icons/arrow-left-right.svg" mode="aspectFit" />
            <text class="detail__relation-target">{{rel.word}}</text>
          </view>
          <text class="detail__relation-type">{{rel.typeLabel}}</text>
        </view>
        <text wx:if="{{rel.explanation}}" class="detail__relation-text">{{rel.explanation}}</text>
        <view wx:if="{{rel.exampleEn}}" class="detail__relation-example">
          <view class="detail__token-line">
            <view
              wx:for="{{rel.exampleEnTokens}}"
              wx:key="index"
              wx:for-item="token"
              class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
              data-word="{{token.value}}"
              catchtap="onSearchToken"
            >{{token.text}}</view>
          </view>
          <text wx:if="{{rel.exampleZh}}" class="detail__example-zh muted">{{rel.exampleZh}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && !relationConfusing.length && learningLoading}}" class="detail__empty card">
      <r-loading compact title="正在检查候选关系" />
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && !relationConfusing.length && !learningLoading && lexicalSuggestions.length}}" class="detail__relation-list">
      <view class="detail__hint-card">
        <text class="detail__hint-title">候选辨析</text>
        <text class="detail__hint-copy">以下内容来自候选关系，适合先用于学习参考；后续人工确认后会进入精选辨析。</text>
      </view>
      <view wx:for="{{lexicalSuggestions}}" wx:key="_id" wx:for-item="rel" class="detail__relation-card is-suggestion">
        <view class="detail__relation-top">
          <view class="detail__relation-pair {{rel.canOpen ? '' : 'is-disabled'}}" data-word="{{rel.word}}" data-open="{{rel.canOpen ? 1 : 0}}" bindtap="onOpenRelationWord">
            <text class="detail__relation-current">{{word.word}}</text>
            <image class="detail__relation-arrow" src="/assets/icons/arrow-left-right.svg" mode="aspectFit" />
            <text class="detail__relation-target">{{rel.word}}</text>
          </view>
          <view class="detail__suggestion-tags">
            <text class="detail__relation-type">{{rel.typeLabel}}</text>
            <text class="detail__suggestion-tag">{{rel.targetHint}}</text>
          </view>
        </view>
        <text wx:if="{{rel.groupTitle}}" class="detail__suggestion-group">{{rel.groupTitle}}</text>
        <text wx:if="{{rel.explanation}}" class="detail__relation-text">{{rel.explanation}}</text>
        <view wx:if="{{rel.exampleEn}}" class="detail__relation-example">
          <view class="detail__token-line">
            <view
              wx:for="{{rel.exampleEnTokens}}"
              wx:key="index"
              wx:for-item="token"
              class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
              data-word="{{token.value}}"
              catchtap="onSearchToken"
            >{{token.text}}</view>
          </view>
          <text wx:if="{{rel.exampleZh}}" class="detail__example-zh muted">{{rel.exampleZh}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!relationsLoading && !relationsError && !relationConfusing.length && confusingItems.length}}" class="detail__sense card">
      <view wx:for="{{confusingItems}}" wx:key="word" wx:for-item="item" class="detail__confusing">
        <text class="detail__syn-word">{{item.word}}</text>
        <view wx:if="{{item.explanation}}" class="detail__token-line detail__syn-nuance">
          <view
            wx:for="{{item.explanationTokens}}"
            wx:key="index"
            wx:for-item="token"
            class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
            data-word="{{token.value}}"
            catchtap="onSearchToken"
          >{{token.text}}</view>
        </view>
        <view wx:if="{{item.example}}" class="detail__token-line detail__example-en">
          <view
            wx:for="{{item.exampleTokens}}"
            wx:key="index"
            wx:for-item="token"
            class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
            data-word="{{token.value}}"
            catchtap="onSearchToken"
          >{{token.text}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{!relationsLoading && !relationsError && !relationConfusing.length && !learningLoading && !lexicalSuggestions.length && !confusingItems.length}}" class="detail__empty card">
      <text class="detail__empty-copy">这个词暂时没有精选辨析内容</text>
    </view>
  </view>

  <view wx:if="{{activeTab === 'suggestions'}}" class="detail__panel">
    <view wx:if="{{learningLoading}}" class="detail__empty card">
      <r-loading compact title="正在读取候选内容" description="候选内容不会自动当作正式辨析" />
    </view>
    <view wx:if="{{!learningLoading && learningError}}" class="detail__empty card">
      <text class="detail__empty-copy">请确认 wordbook-fetch 云函数已重新上传，或稍后再试</text>
    </view>
    <view wx:if="{{!learningLoading && !learningError && !lexicalSuggestions.length}}" class="detail__empty card">
      <text class="detail__empty-copy">这个词暂时没有 AI 候选近义/同类关系</text>
    </view>
    <view wx:if="{{!learningLoading && !learningError && lexicalSuggestions.length}}" class="detail__relation-list">
      <view wx:for="{{lexicalSuggestions}}" wx:key="_id" wx:for-item="rel" class="detail__relation-card is-suggestion">
        <view class="detail__relation-top">
          <view class="detail__relation-pair {{rel.canOpen ? '' : 'is-disabled'}}" data-word="{{rel.word}}" data-open="{{rel.canOpen ? 1 : 0}}" bindtap="onOpenRelationWord">
            <text class="detail__relation-current">{{word.word}}</text>
            <image class="detail__relation-arrow" src="/assets/icons/arrow-left-right.svg" mode="aspectFit" />
            <text class="detail__relation-target">{{rel.word}}</text>
          </view>
          <view class="detail__suggestion-tags">
            <text class="detail__relation-type">{{rel.typeLabel}}</text>
            <text class="detail__suggestion-tag">{{rel.targetHint}}</text>
          </view>
        </view>
        <text wx:if="{{rel.groupTitle}}" class="detail__suggestion-group">{{rel.groupTitle}}</text>
        <text wx:if="{{rel.explanation}}" class="detail__relation-text">{{rel.explanation}}</text>
        <view wx:if="{{rel.exampleEn}}" class="detail__relation-example">
          <view class="detail__token-line">
            <view
              wx:for="{{rel.exampleEnTokens}}"
              wx:key="index"
              wx:for-item="token"
              class="detail__token {{token.searchable ? 'detail__token--word' : ''}} {{token.current ? 'detail__token--current' : ''}}"
              data-word="{{token.value}}"
              catchtap="onSearchToken"
            >{{token.text}}</view>
          </view>
          <text wx:if="{{rel.exampleZh}}" class="detail__example-zh muted">{{rel.exampleZh}}</text>
        </view>
      </view>
    </view>
  </view>

  </scroll-view>

  <view
    wx:if="{{tokenPopover.visible}}"
    class="detail__token-popover"
    style="left: {{tokenPopover.x}}px; top: {{tokenPopover.y}}px;"
  >
    <view class="detail__token-popover-arrow" style="left: {{tokenPopover.arrowX}}px;"></view>
    <view class="detail__token-popover-head">
      <view class="detail__token-popover-main">
        <text class="detail__token-popover-word">{{tokenPopover.word}}</text>
        <text wx:if="{{tokenPopover.phonetic}}" class="detail__token-popover-phonetic">{{tokenPopover.phonetic}}</text>
      </view>
      <view class="detail__token-popover-close" bindtap="onCloseTokenPopover">×</view>
    </view>
    <text wx:if="{{tokenPopover.loading}}" class="detail__token-popover-text muted">查询中...</text>
    <text wx:else class="detail__token-popover-text">{{tokenPopover.translation}}</text>
    <view wx:if="{{tokenPopover.found}}" class="detail__token-popover-action" bindtap="onOpenPopoverWord">查看详情</view>
  </view>

  <view wx:if="{{fromLearn}}" class="detail__learn-next">
    <view class="detail__learn-next-button" bindtap="onLearnNext">
      <text class="detail__learn-next-text">继 续</text>
    </view>
  </view>
</view>

<r-loading
  wx:else
  fullscreen
  raised
  title="正在打开单词"
  description="正在读取释义与学习内容"
/>
