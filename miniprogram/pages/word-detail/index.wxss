.detail {
  --detail-accent: var(--coral-500);
  --detail-accent-deep: var(--coral-700);
  --detail-accent-soft: rgba(196, 97, 82, 0.12);
  --detail-tab-card-bg: rgba(253, 251, 247, 0.82);
  --detail-tab-card-border: var(--border-subtle);
  --detail-tab-card-shadow: 0 5rpx 16rpx rgba(44, 42, 38, 0.045);
  padding-top: 0;
  padding-bottom: 0;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 0;
  background: linear-gradient(180deg, #F1DED5 0%, #F0EFEB 30%, #E7EAE8 100%);
}

.detail > study-hero {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  height: auto;
  flex: 0 0 auto;
  transform: translateZ(0);
}
.detail--learn {
  padding-bottom: 0;
}
.detail__state-actions {
  width: 90rpx;
  height: 88rpx;
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 90rpx;
}
.detail__icon-button {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 0;
  background: transparent;
  color: #D97706;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  flex-shrink: 0;
}
.detail__icon-button:active {
  opacity: 0.74;
  transform: scale(0.92);
}
.detail__icon-button.is-active {
  color: #B45309;
  border-color: transparent;
  background: transparent;
  filter: saturate(118%);
}
.detail__icon-button.is-danger {
  color: #DC2626;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}
.detail__icon-button.is-restore {
  color: var(--color-ink);
  background: transparent;
}
.detail__icon-restore {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  margin-top: -3rpx;
}
.detail__action-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}
.detail .word-card__play {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.detail .word-card__play:active {
  transform: scale(0.94);
  opacity: 0.78;
}
.detail .word-card__play-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
}

.detail__tabs {
  position: relative;
  width: 100%;
  display: flex;
  height: 64rpx;
  min-height: 64rpx;
  margin: 16rpx 0 16rpx;
  padding: 4rpx;
  box-sizing: border-box;
  /* border: 1rpx solid rgba(196, 97, 82, 0.28); */
  border-radius: 14rpx;
  /* background: linear-gradient(135deg, rgba(255, 225, 215, 0.94), rgba(255, 239, 225, 0.90)); */
  box-shadow: none;
}
.detail__tabs-track {
  display: flex;
  flex: 1;
  min-width: 0;
  width: 100%;
  gap: 0;
  box-sizing: border-box;
}
.detail__tab {
  position: relative;
  width: calc((100% - 64rpx) / 5);
  margin-left: 16rpx;
  flex: 0 0 calc((100% - 64rpx) / 5);
  min-width: 0;
  height: 56rpx;
  padding: 0;
  border-radius: 10rpx;
  overflow: hidden;
  color: var(--coral-700);
  font-size: 22rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 56rpx;
  white-space: nowrap;
  /* background: rgba(255, 252, 247, 0.84); */
   background: linear-gradient(135deg, rgba(255, 225, 215, 0.94), rgba(255, 239, 225, 0.90));
  box-shadow: none;
  border: 1rpx solid rgba(196, 97, 82, 0.36);
  transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
}
.detail__tab:first-child {
  margin-left: 0;
}
.detail__tab--active {
  color: var(--color-white);
  border-color: #A84035;
  background: linear-gradient(135deg, #F08B6D 0%, #C45146 100%);
  box-shadow: 0 7rpx 16rpx rgba(173, 66, 55, 0.24);
  transform: none;
  font-size: 22rpx;
  font-weight: 700;
}
.detail__panel {
  display: flex;
  flex-direction: column;
  gap: 0;
  min-height: 0;
  margin: 0;
  padding: 4rpx 24rpx 48rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}
.detail__basic-loading {
  min-height: 0;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.065);
  display: flex;
  align-items: stretch;
}
.detail__panel > view:first-child {
  border-top: 0;
}
.detail__body {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
.detail__body--learn .detail__panel {
  min-height: 0;
}
.detail__body--learn {
  margin-bottom: calc(env(safe-area-inset-bottom) + var(--button-height) + 56rpx);
  padding-bottom: 0;
}
.detail__short-definition {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.detail__short-definition .detail__section-title,
.detail__collocation-card .detail__section-title,
.detail__source-card .detail__section-title {
  display: block;
  margin: 0;
}

.detail__short-definition .detail__section-title {
  margin-bottom: 14rpx;
}
.detail__short-definition-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 0;
  padding: 0 !important;
  border-radius: 0;
  background: transparent;
  border: 0 !important;
  transition: background 0.16s ease;
}
.detail__short-definition-row:first-of-type {
  padding: 0 !important;
  border: 0 !important;
}
.detail__short-definition-row--press {
  background: rgba(26, 26, 26, 0.025);
}
.detail__short-definition-row.is-expanded {
  background: transparent;
}
.detail__short-definition-en {
  display: block;
  min-width: 0;
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.56;
  word-break: break-word;
}
.detail__short-definition-zh {
  display: block;
  color: rgba(26, 26, 26, 0.62);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.detail__sense {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.065);
}

.detail__sense:first-child {
  border-top: 0;
  padding-top: 0;
}

.detail__sense:last-child {
  padding-bottom: 0;
}

.detail__sense.card {
  padding: 22rpx 24rpx;
  border-top: 0;
}

.detail__sense-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}
.detail__pos {
  min-width: 0;
  padding: 4rpx 0 0;
  background: transparent;
  border: 0;
  color: var(--detail-accent);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: left;
  text-transform: lowercase;
  flex-shrink: 0;
}
.detail__translation {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: rgba(26, 26, 26, 0.92);
  line-height: 1.48;
  min-width: 0;
  word-break: break-word;
  overflow-wrap: anywhere;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.detail__translation-line {
  display: block;
  line-height: 1.48;
}

.detail__section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 750;
  color: #965B52;
  letter-spacing: 0;
  line-height: 1.36;
}

.detail__syn {
  background: var(--color-bg);
  border-radius: var(--radius-btn);
  padding: var(--space-2) var(--space-3);
  margin-top: var(--space-1);
}
.detail__syn-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.detail__syn-word {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary-deep);
}
.detail__syn-toggle { font-size: 22rpx; }

.detail__syn-body {
  margin-top: var(--space-2);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.detail__syn-nuance {
  font-size: 26rpx;
  color: var(--color-graphite);
  line-height: 1.5;
}
.detail__syn-example {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: var(--space-2);
  background: var(--color-white);
  border-radius: var(--radius-btn);
}

.detail__relation {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-3) 0;
  border-top: 2rpx solid var(--color-hairline);
}
.detail__relation:first-child {
  border-top: 0;
  padding-top: 0;
}
.detail__relation:last-child {
  padding-bottom: 0;
}
.detail__relation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}
.detail__relation-main {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
}
.detail__relation-type {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 36rpx;
  flex-shrink: 0;
}
.detail__relation-text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.56;
  color: var(--text-primary);
}

.detail__relation-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.detail__relation-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 22rpx 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  border-top: 1rpx solid rgba(48, 48, 44, 0.08);
  box-shadow: none;
}
.detail__relation-card:first-child {
  border-top: 0;
  padding-top: 0;
}

.detail__relation-card.is-suggestion {
  opacity: 0.94;
}

.detail__relation-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail__relation-pair {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  min-height: 42rpx;
}

.detail__relation-pair.is-disabled {
  opacity: 0.72;
}

.detail__relation-current,
.detail__relation-target {
  max-width: 230rpx;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1.28;
  color: var(--color-ink);
  overflow-wrap: anywhere;
}

.detail__relation-target {
  color: var(--color-primary-deep);
}

.detail__relation-arrow {
  width: 20rpx;
  height: 20rpx;
  display: block;
  opacity: 0.64;
  flex-shrink: 0;
}

.detail__relation-card .detail__relation-type {
  height: auto;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  color: rgba(26, 26, 26, 0.46);
  font-size: 21rpx;
  font-weight: 850;
  line-height: 1.28;
  transform: translateY(1rpx);
}

.detail__relation-card .detail__relation-text {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: var(--color-secondary);
  border: 1rpx solid var(--color-border);
  color: rgba(26, 26, 26, 0.78);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.62;
}

.detail__relation-example {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: var(--color-secondary);
  border: 1rpx solid var(--color-border);
}

.detail__relation-example .detail__token {
  font-size: 26rpx;
  color: rgba(26, 26, 26, 0.82);
}

.detail__suggestion-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.detail__suggestion-tag {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 21rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.detail__suggestion-group {
  font-size: 23rpx;
  color: rgba(26, 26, 26, 0.52);
  line-height: 1.4;
}

.detail__hint-card {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.065);
}

.detail__hint-title {
  font-size: 26rpx;
  font-weight: 850;
  color: var(--color-ink);
  line-height: 1.35;
}

.detail__hint-copy {
  font-size: 23rpx;
  color: rgba(26, 26, 26, 0.56);
  line-height: 1.45;
}

.detail__ai-expansion {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
}

.detail__ai-expansion-copy {
  color: rgba(26, 26, 26, 0.76);
  font-size: 27rpx;
  font-weight: 520;
  line-height: 1.6;
}

.detail__ai-list-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(48, 48, 44, 0.06);
}

.detail__ai-list-item:first-child {
  padding-top: 8rpx;
  border-top: 0;
}

.detail__ai-list-break {
  height: 10rpx;
  border-top: 1rpx solid rgba(48, 48, 44, 0.11);
}

.detail__ai-list-title {
  color: var(--coral-700);
  font-size: 21rpx;
  font-weight: 760;
  line-height: 1.25;
}

.detail__ai-example {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 2rpx;
  padding: 12rpx 0 0 16rpx;
  border-left: 2rpx solid rgba(218, 97, 78, 0.46);
}

.detail__ai-example-en {
  color: rgba(26, 26, 26, 0.82);
  font-size: 24rpx;
  font-weight: 620;
  line-height: 1.5;
}

.detail__ai-example-zh {
  color: rgba(26, 26, 26, 0.5);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
}

.detail__learn-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 0;
  background: transparent;
  border: 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.065);
  box-shadow: none;
}
.detail__learn-card:first-child {
  border-top: 0;
}

.detail__learn-head {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail__learn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.56;
}

.detail__segment-list,
.detail__related-list {
  display: flex;
  flex-direction: column;
}

.detail__segment-list {
  gap: 0;
}

.detail__related-list {
  gap: 10rpx;
}

.detail__segment {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 7rpx;
  padding: 16rpx 0 14rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(196, 97, 82, 0.16);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.detail__segment:last-child {
  border-bottom: 0;
}

.detail__segment-form {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1.24;
}

.detail__segment-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.detail__segment-type {
  height: 30rpx;
  padding: 0 10rpx;
  border: 1rpx solid #EDB6A8;
  border-radius: var(--radius-pill);
  background: #FFE7DF;
  color: #B75443;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  box-sizing: border-box;
  white-space: nowrap;
}

.detail__segment-meaning {
  min-width: 0;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-word;
}

.detail__related-copy {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.62);
  line-height: 1.45;
}

.detail__mini-title {
  font-size: 21rpx;
  font-weight: 650;
  color: var(--text-tertiary);
  line-height: 1.3;
}

.detail__related-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(48, 48, 44, 0.08);
}

.detail__related-word {
  min-width: 0;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.detail__pattern,
.detail__error-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.06);
}

.detail__pattern:first-of-type,
.detail__error-item:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.detail__pattern-title,
.detail__error-title {
  font-size: 27rpx;
  font-weight: 850;
  color: var(--color-ink);
  line-height: 1.35;
}

.detail__confusing {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-2) 0;
  border-top: 2rpx solid var(--color-hairline);
}
.detail__confusing:first-child {
  border-top: 0;
  padding-top: 0;
}

.detail__antonyms {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-top: var(--space-1);
}

.detail__example-en {
  font-size: 28rpx;
  color: var(--color-ink);
  line-height: 1.5;
}

.detail__inflections {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.detail__inflection-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.detail__inflection-item {
  min-width: 154rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: var(--surface-muted);
  border: 1rpx solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.detail__inflection-form {
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.detail__inflection-label {
  color: var(--color-muted);
  font-size: 19rpx;
  line-height: 1.3;
}

.detail__source-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.detail__source-head {
  display: block;
}

.detail__source-head > view {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail__source-action {
  height: 36rpx;
  padding: 5rpx 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  color: var(--detail-accent-deep);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.35;
  flex-shrink: 0;
}

.detail__source-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
.detail__token-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  line-height: 1.48;
}
.detail__token {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.56;
  white-space: pre-wrap;
}
.detail__token--word {
  color: var(--color-ink);
}
.detail__token--current {
  display: inline;
  padding: 0 2rpx;
  margin: 0;
  border-radius: 0;
  color: var(--detail-accent-deep);
  font-weight: 700;
  line-height: 1.48;
  background: linear-gradient(180deg, transparent 66%, rgba(222, 139, 114, 0.3) 66%);
}
.detail__token--word:active {
  color: var(--color-primary);
  text-decoration: underline;
}
.detail__token-popover {
  position: fixed;
  z-index: 90;
  width: 384rpx;
  max-width: calc(100vw - 48rpx);
  transform: translateX(-50%);
  padding: 22rpx;
  border-radius: 16rpx;
  background: var(--surface-card-solid);
  box-shadow: var(--shadow-raised);
  border: 1rpx solid var(--border-subtle);
}
.detail__token-popover-arrow {
  position: absolute;
  top: -10rpx;
  width: 22rpx;
  height: 22rpx;
  transform: translateX(-50%) rotate(45deg);
  background: rgba(255, 255, 255, 0.98);
  border-left: 1rpx solid rgba(0, 0, 0, 0.06);
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}
.detail__token-popover-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}
.detail__token-popover-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.detail__token-popover-word {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.2;
}
.detail__token-popover-phonetic {
  font-size: 22rpx;
  color: var(--color-graphite);
  line-height: 1.3;
}
.detail__token-popover-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: transparent;
  color: var(--color-graphite);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}
.detail__token-popover-text {
  display: block;
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--color-ink);
  line-height: 1.45;
}
.detail__token-popover-action {
  margin-top: var(--space-2);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.detail__example-zh {
  display: block;
  margin-top: 0;
  font-size: 25rpx;
  font-weight: 500;
  color: rgba(26, 26, 26, 0.66);
  line-height: 1.5;
}

.detail__examples {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 22rpx 24rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.detail__empty {
  flex: 0 0 auto;
  min-height: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 188rpx 28rpx 72rpx !important;
  color: rgba(26, 26, 26, 0.58);
  text-align: center;
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.detail__empty-copy {
  max-width: 520rpx;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.5);
  line-height: 1.5;
}

.detail__example-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(26, 26, 26, 0.07);
}
.detail__example-card:first-of-type {
  border-top: 0;
}
.detail__examples > .detail__example-card:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.detail__examples > .row-between {
  margin-bottom: 14rpx;
}
.detail__example-main {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  min-width: 0;
  flex: 1;
}
.detail__example-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--color-bg);
  flex-shrink: 0;
}
.detail__example-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}
.detail__example-source {
  font-size: 22rpx;
  line-height: 1.4;
}
.detail__example-play {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #292826;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(26, 26, 26, 0.12);
}
.detail__example-play:active {
  transform: scale(0.94);
}
.detail__example-play-icon {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 15rpx solid var(--color-white);
}

.detail__learn-next {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 80;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
  pointer-events: none;
}
.detail__learn-next-button {
  width: 100%;
  max-width: 520rpx;
  min-height: var(--button-height);
  margin: 0 auto;
  border-radius: var(--button-radius);
  background: var(--button-primary-bg);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(44, 42, 38, 0.12);
  pointer-events: auto;
}
.detail__learn-next-button:active {
  transform: none;
}
.detail__learn-next-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-white);
  line-height: 1.2;
}

.detail__learn-next--press {
  opacity: 0.86;
  box-shadow: 0 8rpx 20rpx rgba(35, 34, 32, 0.13);
}

.detail__tab--press {
  opacity: 0.72;
}

.detail__tab-label {
  position: relative;
  z-index: 2;
  display: block;
  max-width: none;
  overflow: visible;
  text-overflow: clip;
  white-space: nowrap;
}

.detail__short-definition-zh,
.detail__example-zh,
.detail__collocation-sub {
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.55;
}

.detail__collocation-card {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 22rpx 26rpx 18rpx !important;
  border-radius: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  overflow: hidden;
}

.detail__collocation-head {
  padding: 0 0 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-start;
}

.detail__collocation-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 0;
}

.detail__collocation-row,
.detail__collocation-row.is-expanded {
  width: 100%;
  min-height: 0;
  margin: 0;
  padding: 7rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-sizing: border-box;
  transition: background 0.16s ease;
}

.detail__collocation-row:first-child {
  margin: 0;
  padding-top: 0;
  border: 0;
}

.detail__collocation-row:last-child {
  margin: 0;
  padding-bottom: 6rpx;
  border: 0;
}

.detail__collocation-row.is-expanded {
  background: transparent;
  box-shadow: none;
}

.detail__collocation-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.detail__collocation-main {
  display: block;
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.56;
  word-break: break-word;
}

.detail__collocation-sub,
.detail__collocation-row.is-expanded .detail__collocation-sub {
  display: block;
  max-width: 100%;
  text-align: left;
  font-size: 22rpx;
  line-height: 1.48;
}

.detail__learn-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail__learn-badge {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  box-sizing: border-box;
  color: var(--text-secondary);
  background: var(--surface-muted);
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1;
  white-space: nowrap;
}

.detail__learn-badge--source {
  color: #2D7A54;
  background: #E4F5EA;
  border-color: #A9D9BB;
}

.detail__learn-badge--priority {
  color: #B94F40;
  background: #FFE4DC;
  border-color: #EEAC9D;
}

.detail__learn-badge--writing {
  color: #A86516;
  background: #FFF0D2;
  border-color: #ECC47F;
}

.detail__source-footer {
  min-height: 42rpx;
  margin-top: 6rpx;
  padding-top: 4rpx;
  border-top: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.detail__examples > .row-between + .detail__example-card {
  padding-top: 0;
  border-top: 0;
}

.detail__panel > .detail__empty.card {
  flex: 0 0 auto;
  width: 100%;
  height: auto;
  min-height: 560rpx;
  box-sizing: border-box;
  border: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.detail__body--learn .detail__panel > .detail__empty.card {
  min-height: 560rpx;
}

/* Radiant v2: reading-light detail surface */
.detail {
  --page-accent: var(--coral-500);
  --page-accent-deep: var(--coral-700);
  --page-accent-wash: rgba(196, 97, 82, 0.12);
  background:
    radial-gradient(circle at 50% 0%, rgba(232, 177, 157, 0.18), transparent 34%),
    var(--surface-canvas);
}

.detail > study-hero {
  --study-hero-bar-height: 88rpx;
  --study-hero-progress-top: 78rpx;
  --study-hero-heading-margin-top: 18rpx;
  --study-hero-heading-padding-x: 0;
  --study-hero-heading-padding-bottom: 24rpx;
  --study-hero-heading-justify: flex-start;
  --word-heading-align: flex-start;
  --word-heading-title-justify: flex-start;
  --word-heading-word-size: 62rpx;
  --word-heading-pron-align: flex-start;
  --word-heading-width: 100%;
  --word-heading-text-align: left;
}

.detail__panel > .card,
.detail__panel > view > .card,
.detail__panel > .detail__relation-list,
.detail__panel > view > .detail__relation-list,
.detail__panel > .detail__hint-card,
.detail__panel > view > .detail__hint-card {
  margin: 0;
  padding: 16rpx 0;
  border: 0;
  border-top: 1rpx solid rgba(83, 64, 59, 0.11);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
}

.detail__panel > .detail__collocation-card {
  padding: 16rpx 0 !important;
}

.detail__panel > .card:first-child,
.detail__panel > view:first-child > .card,
.detail__panel > .detail__relation-list:first-child,
.detail__panel > view:first-child > .detail__relation-list,
.detail__panel > .detail__empty:first-child,
.detail__panel > .detail__basic-loading:first-child {
  border-top: 0;
}
