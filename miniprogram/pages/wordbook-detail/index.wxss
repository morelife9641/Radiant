.wbd {
  min-height: 100vh;
  padding-top: var(--space-3);
  padding-bottom: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.wbd__loading {
  min-height: 100vh;
  padding-top: var(--space-3);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.wbd__hero {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.wbd__cover {
  width: 108rpx;
  height: 144rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-white);
  font-size: 44rpx;
  font-weight: 800;
  flex-shrink: 0;
  overflow: hidden;
}
.wbd__cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.wbd__meta {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
  flex: 1;
}
.wbd__title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.3;
}

.wbd__sort {
  display: inline-flex;
  align-self: flex-start;
  background: var(--color-white);
  border-radius: var(--radius-pill);
  padding: 4rpx;
  box-shadow: var(--shadow-soft);
}
.wbd__sort-item {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: var(--color-graphite);
  border-radius: var(--radius-pill);
}
.wbd__sort-item.is-active {
  background: var(--color-primary);
  color: var(--color-white);
}

.wbd__search {
  height: 72rpx;
  padding: 0 var(--space-3);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}
.wbd__search--press {
  transform: scale(0.98);
}
.wbd__search-icon {
  font-size: 30rpx;
  color: var(--color-graphite);
  line-height: 1;
}
.wbd__search-placeholder {
  min-width: 0;
  flex: 1;
  font-size: 26rpx;
  color: var(--color-graphite);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wbd__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  height: calc(100vh - 420rpx);
}
.wbd__word {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-3);
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  margin-bottom: var(--space-2);
  min-height: 96rpx;
}
.wbd__word--press {
  transform: scale(0.98);
}
.wbd__word-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  width: 260rpx;
  flex-shrink: 0;
}
.wbd__word-text {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wbd__phonetic {
  font-size: 22rpx;
  color: var(--color-graphite);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wbd__translation {
  font-size: 26rpx;
  color: var(--color-graphite);
  line-height: 1.4;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.wbd__footer {
  min-height: 92rpx;
  text-align: center;
  padding: var(--space-2) 0;
  font-size: 24rpx;
}
