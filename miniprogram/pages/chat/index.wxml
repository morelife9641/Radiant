<view class="page chat">
  <view class="chat__header row-between" style="padding-top:{{statusBarHeight + 16}}px">
    <view class="col gap-1">
      <text class="chat__name">{{role.name}}</text>
      <text class="caption muted">{{role.scene}}</text>
    </view>
    <view class="chat__gear" bindtap="onChangeRole">⚙</view>
  </view>

  <scroll-view scroll-y class="chat__list" scroll-into-view="{{anchor}}" enhanced bounces="{{false}}">
    <view class="chat__list-inner">
      <view wx:for="{{messages}}" wx:key="id" id="m-{{item.id}}">
        <chat-bubble role="{{item.role}}" content="{{item.content}}" suggestion="{{item.suggestion}}" bind:apply="onApplySuggestion" />
      </view>
    </view>
  </scroll-view>

  <view class="chat__input safe-bottom">
    <view class="chat__mic">🎙</view>
    <input class="chat__field" placeholder="说点什么…" value="{{draft}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <view class="chat__send {{draft ? 'is-active' : ''}}" bindtap="onSend">↑</view>
  </view>
</view>
