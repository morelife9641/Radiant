.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  padding-top: 0;
}

.chat__header {
  padding: var(--chat-status-h, 88rpx) var(--page-padding-x) var(--space-3);
  background: var(--color-white);
  border-bottom: 2rpx solid var(--color-hairline);
}
.chat__name { font-size: 32rpx; font-weight: 700; color: var(--color-ink); }
.chat__gear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.chat__list {
  flex: 1;
  padding: var(--space-3) var(--page-padding-x);
  background: var(--color-bg);
}
.chat__list-inner {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.chat__input {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--page-padding-x) calc(112rpx + env(safe-area-inset-bottom));
  background: var(--color-white);
  border-top: 2rpx solid var(--color-hairline);
}
.chat__mic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.chat__field {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
}
.chat__send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-hairline);
  color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.chat__send.is-active {
  background: var(--color-primary);
}
