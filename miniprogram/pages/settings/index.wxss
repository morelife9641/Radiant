.settings {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx);
  background: transparent;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  overflow: visible;
}
.settings__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 72rpx;
}
.settings__heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.settings__title {
  font-size: 42rpx;
  font-weight: 900;
  color: rgba(26, 26, 26, 0.94);
  line-height: 1.08;
}
.settings__subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(92, 19, 14, 0.42);
  line-height: 1.3;
}
.settings__panel {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.settings__section {
  position: relative;
  border-radius: 28rpx;
  padding: 16rpx;
  background: rgba(26, 26, 26, 0.025);
  border: 1rpx solid rgba(26, 26, 26, 0.045);
  box-shadow:
    0 10rpx 26rpx rgba(26, 26, 26, 0.035),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.settings__section-title {
  display: block;
  padding: 2rpx 12rpx 14rpx;
  font-size: 21rpx;
  font-weight: 850;
  color: rgba(244, 91, 79, 0.72);
  line-height: 1.2;
}
.settings__item {
  min-height: 104rpx;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: rgba(26, 26, 26, 0.9);
}
.settings__item + .settings__item {
  margin-top: 4rpx;
}
.settings__item--switch {
  min-height: 112rpx;
}
.settings__switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
.settings__item--press {
  background: rgba(244, 91, 79, 0.06);
  transform: scale(0.99);
}
.settings__item-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.settings__item-title {
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.25;
}
.settings__item-desc {
  max-width: 430rpx;
  font-size: 22rpx;
  font-weight: 650;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.settings__item-value {
  min-width: 0;
  max-width: 280rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(92, 19, 14, 0.58);
  line-height: 1.2;
  white-space: nowrap;
}
.settings__item-value text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
}
.settings__chevron,
.settings__version {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 850;
  color: rgba(244, 91, 79, 0.6);
  line-height: 1;
}
.settings__version {
  font-size: 23rpx;
  color: rgba(92, 19, 14, 0.48);
}
.settings__danger {
  min-height: 104rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(230, 57, 70, 0.045);
  border: 1rpx solid rgba(230, 57, 70, 0.14);
  box-shadow:
    0 10rpx 26rpx rgba(26, 26, 26, 0.035);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.settings__danger--press {
  opacity: 0.82;
  transform: scale(0.99);
}
.settings__danger-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.settings__danger-title {
  font-size: 27rpx;
  font-weight: 850;
  color: #b42318;
  line-height: 1.25;
}
.settings__danger-desc {
  font-size: 21rpx;
  font-weight: 650;
  color: rgba(180, 35, 24, 0.54);
  line-height: 1.35;
}
.settings__danger-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 850;
  color: rgba(180, 35, 24, 0.56);
  line-height: 1;
}
