.settings {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 44rpx);
  background: linear-gradient(180deg, #F2DED4 0%, #F0EEE9 34%, #E6EAE8 100%);
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  overflow: visible;
}
.settings__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 72rpx;
}
.settings__heading {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.settings__title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.08;
}
.settings__subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  line-height: 1.3;
}
.settings__panel {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.settings__section {
  position: relative;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}
.settings__section-title {
  display: block;
  padding: 2rpx 4rpx 12rpx;
  font-size: 21rpx;
  font-weight: 850;
  color: var(--coral-700);
  line-height: 1.2;
}
.settings__item {
  min-height: 104rpx;
  padding: 20rpx 18rpx;
  border-radius: 0;
  border-bottom: 1rpx solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: rgba(26, 26, 26, 0.9);
}
.settings__item + .settings__item {
  margin-top: 0;
}
.settings__item--switch {
  min-height: 112rpx;
}
.settings__switch {
  flex-shrink: 0;
  transform: scale(0.86);
  transform-origin: right center;
}
.settings__item--press {
  background: var(--surface-pressed);
}
.settings__item-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.settings__item-title {
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.25;
}
.settings__item-desc {
  max-width: 430rpx;
  font-size: 22rpx;
  font-weight: 650;
  color: var(--text-tertiary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.settings__item-value {
  min-width: 0;
  max-width: 280rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-secondary);
  line-height: 1.2;
  white-space: nowrap;
}
.settings__item-value text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
}
.settings__chevron,
.settings__version {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 850;
  color: var(--coral-500);
  line-height: 1;
}
.settings__version {
  font-size: 23rpx;
  color: var(--text-tertiary);
}
.settings__danger {
  min-height: 104rpx;
  padding: 22rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--state-error-bg);
  border: 1rpx solid rgba(163, 70, 61, 0.24);
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.settings__danger--press {
  opacity: 0.82;
}
.settings__danger-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.settings__danger-title {
  font-size: 27rpx;
  font-weight: 850;
  color: var(--state-error-fg);
  line-height: 1.25;
}
.settings__danger-desc {
  font-size: 21rpx;
  font-weight: 650;
  color: rgba(163, 70, 61, 0.68);
  line-height: 1.35;
}
.settings__danger-arrow {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 850;
  color: rgba(180, 35, 24, 0.56);
  line-height: 1;
}
