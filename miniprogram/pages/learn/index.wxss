.learn,
page {
  height: 100%;
  overflow: hidden;
}

.learn {
  --learn-accent: var(--amber-500);
  --learn-accent-deep: var(--amber-700);
  --learn-accent-wash: rgba(199, 121, 36, 0.18);
  --learn-border: var(--border-subtle);
  --learn-shadow: rgba(74, 49, 31, 0.045);
  --learn-surface: rgba(255, 249, 241, 0.64);
  --learn-surface-strong: rgba(255, 249, 241, 0.82);
  --learn-surface-border: rgba(111, 65, 32, 0.15);
  --word-card-focus: rgba(140, 77, 22, 0.48);
  --word-card-focus-soft: rgba(140, 77, 22, 0.1);
  --word-card-meta-color: #76512B;
  --word-card-option-bg: #FFFDFC;
  --word-card-option-border: rgba(112, 78, 56, 0.12);
  --word-card-option-shadow: 0 5rpx 14rpx rgba(74, 52, 37, 0.05);
  --word-card-option-meta-fg: #765033;
  --word-card-selected-bg: #FFE4CC;
  --word-card-selected-border: #D99460;
  --word-card-correct-bg: #EDF7F1;
  --word-card-correct-border: #B4D7C2;
  --word-card-selected-correct-bg: #DFF2E6;
  --word-card-selected-correct-border: #70A987;
  --word-card-selected-wrong-bg: #FBE7E3;
  --word-card-selected-wrong-border: #D58D82;
  position: relative;
  padding-top: 0;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: linear-gradient(180deg, #FFE4CF 0%, #F9EEE5 46%, #F3F0EC 100%);
  transition: background var(--dur-base) var(--ease-out);
}
.learn.is-review-mode {
  --learn-accent: var(--coral-500);
  --learn-accent-deep: var(--coral-700);
  --learn-accent-wash: rgba(196, 97, 82, 0.18);
  --learn-shadow: rgba(82, 48, 43, 0.045);
  --learn-surface: rgba(255, 250, 247, 0.66);
  --learn-surface-strong: rgba(255, 250, 247, 0.84);
  --learn-surface-border: rgba(105, 66, 59, 0.14);
  --word-card-focus: rgba(144, 63, 54, 0.48);
  --word-card-focus-soft: rgba(144, 63, 54, 0.1);
  --word-card-meta-color: #844940;
  --word-card-option-bg: #FFFDFC;
  --word-card-option-border: rgba(112, 73, 66, 0.12);
  --word-card-option-shadow: 0 5rpx 14rpx rgba(78, 48, 43, 0.045);
  --word-card-option-meta-fg: #7C514A;
  --word-card-selected-bg: #FFE1D7;
  --word-card-selected-border: #CC8372;
  background: linear-gradient(180deg, #FFE0D8 0%, #F8EBE7 46%, #F2EFEC 100%);
}
.learn.is-review-mode .learn__card-wrap {
  background: transparent;
}
.learn.is-review-mode .learn__view-button {
  background: rgba(26, 26, 26, 0.92);
}
.learn.is-review-mode .learn__icon-button {
  background: transparent;
}
.learn.is-review-mode .learn__icon-button.is-danger {
  background: transparent;
}
.learn.is-review-mode .learn__stats,
.learn.is-review-mode .learn__home-button {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(38, 34, 31, 0.12);
  backdrop-filter: none;
}
.learn.is-review-mode .learn__history {
  background: transparent;
  border-color: transparent;
  backdrop-filter: none;
}

.learn > study-hero {
  position: relative;
  z-index: 2;
  display: block;
  width: 100%;
  flex: 0 0 auto;
  --color-ink: var(--text-primary);
  --study-progress-track: rgba(29, 29, 27, 0.16);
  --study-progress-fill: var(--learn-accent);
  --study-progress-glow: rgba(199, 121, 36, 0.32);
}
.learn.is-review-mode > study-hero {
  --study-progress-glow: rgba(196, 97, 82, 0.34);
}
.learn__meta {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
}
.learn__mode-label {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(52, 43, 37, 0.56);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.2;
  letter-spacing: 0;
  padding: 0;
  background: transparent;
}
.learn__progress-text {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  padding: 0;
  background: transparent;
  box-shadow: none;
}
.learn__progress {
  height: 6rpx;
  flex: 0 0 6rpx;
  background: rgba(26, 26, 26, 0.14);
  border-radius: var(--radius-pill);
  overflow: hidden;
  margin: 8rpx 0 0;
}
.learn__state-actions {
  width: 90rpx;
  height: 88rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}
.learn__icon-button {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 0;
  background: transparent;
  color: var(--learn-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  flex-shrink: 0;
}

.learn__icon-button:active {
  opacity: 0.74;
  transform: scale(0.92);
}
.learn__icon-button.is-active {
  color: var(--learn-accent-deep);
  border-color: transparent;
  background: transparent;
}
.learn__icon-button.is-danger {
  color: #DC2626;
  border-color: transparent;
  background: transparent;
  box-shadow: none;
}
.learn__action-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}
.learn__card-wrap {
  position: relative;
  z-index: 2;
  min-height: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
  box-sizing: border-box;
}

.learn__card-wrap word-card {
  display: block;
  flex: 1 1 auto;
  min-height: 0;
  overflow: visible;
  pointer-events: auto;
}
.learn .word-card {
  height: 100%;
  min-height: 0;
  overflow: visible;
  pointer-events: auto;
}
.learn .word-card__quiz {
  min-height: 0;
  gap: 14rpx;
  pointer-events: auto;
}
.learn .word-card__option {
  height: 152rpx;
  min-height: 152rpx;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  pointer-events: auto;
}
.learn .word-card__option.is-detail {
  height: 152rpx;
  min-height: 152rpx;
}
.learn .word-card__prompt-text {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.42;
}
.learn__actions {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 46rpx);
  z-index: 80;
  padding: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
  pointer-events: none;
}
.learn__view-button {
  width: 100%;
  max-width: 520rpx;
  min-height: 84rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: var(--ink-950);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 16rpx 34rpx rgba(26, 26, 26, 0.22),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
  pointer-events: auto;
}
.learn__view-button-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-white);
  line-height: 1.2;
}
.learn__answer-button {
  position: relative;
  width: 100%;
  max-width: 520rpx;
  min-height: 84rpx;
  margin: 0 auto;
  border-radius: 999rpx;
  background: var(--surface-card-solid);
  border: 1rpx solid var(--border-strong);
  box-shadow:
    0 16rpx 34rpx rgba(43, 38, 34, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  color: rgba(26, 26, 26, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: auto;
}
.learn__answer-button-text {
  position: relative;
  z-index: 1;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.learn__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  flex: 1;
  min-height: 0;
  padding: 10rpx 0 calc(env(safe-area-inset-bottom) + 14rpx);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  text-align: center;
  overflow: hidden;
}
.learn__completion-head {
  width: 100%;
  min-height: 82rpx;
  box-sizing: border-box;
  padding: 8rpx 4rpx 6rpx;
  background: transparent;
  border: 0;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  flex: 0 0 auto;
  text-align: center;
}
.learn__completion-head.is-empty {
  justify-content: center;
  min-height: 72rpx;
  text-align: center;
}
.learn__empty-copy {
  min-width: 0;
  padding: 0 8rpx 5rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(26, 26, 26, 0.86);
  line-height: 1.22;
  background: linear-gradient(180deg, transparent 72%, var(--learn-accent-wash) 72%);
}
.learn__completion-head.is-empty .learn__empty-copy {
  max-width: 560rpx;
  padding-bottom: 0;
  color: rgba(26, 26, 26, 0.62);
  font-size: 25rpx;
  font-weight: 600;
  background: transparent;
}
.learn__completion-total {
  color: rgba(26, 26, 26, 0.4);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.3;
}

.learn__stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  width: 100%;
  min-height: 78rpx;
  margin: 0;
  padding: 7rpx 12rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: var(--learn-surface-strong);
  border: 1rpx solid var(--learn-surface-border);
  box-shadow: 0 10rpx 24rpx var(--learn-shadow);
}
.learn__stat {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 8rpx 12rpx;
}
.learn__stat + .learn__stat::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 1rpx;
  background: rgba(26, 26, 26, 0.08);
}
.learn__stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1;
}
.learn__history {
  width: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: 2rpx 0 0;
  border-radius: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
  display: flex;
  flex-direction: column;
  gap: 0;
  flex: 1;
  overflow: hidden;
}
.learn__history-list {
  height: 0;
  min-height: 0;
  flex: 1;
}
.learn__history-item {
  min-height: 68rpx;
  margin-bottom: 9rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(38, 34, 31, 0.11);
  border-radius: 12rpx;
  background: var(--learn-surface);
  display: flex;
  align-items: center;
  transition: background 160ms ease, border-color 160ms ease;
}
.learn__history-item:first-child {
  margin-top: 0;
}
.learn__history-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.learn__history-word {
  flex: 0 1 42%;
  min-width: 0;
  max-width: 42%;
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.learn__history-summary {
  min-width: 0;
  flex: 1;
  color: rgba(26, 26, 26, 0.52);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.learn__history-item.is-correct {
  background: linear-gradient(90deg, var(--state-success-bg) 0%, var(--surface-card-solid) 76%);
  border-color: rgba(54, 116, 85, 0.34);
}
.learn__history-item.is-wrong {
  background: linear-gradient(90deg, var(--state-error-bg) 0%, var(--surface-card-solid) 76%);
  border-color: rgba(163, 70, 61, 0.34);
}
.learn__empty-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 2rpx;
  flex: 0 0 auto;
}
.learn__more-button,
.learn__home-button {
  flex: 1;
  width: 100%;
  min-height: 84rpx;
  flex: 0 0 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  border: 1rpx solid rgba(26, 26, 26, 0.055);
}
.learn__more-button {
  background: var(--ink-950);
  color: #fff;
  border-color: rgba(255, 255, 255, 0.32);
  box-shadow:
    0 16rpx 34rpx rgba(26, 26, 26, 0.18),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}
.learn__home-button {
  background: var(--surface-card-solid);
  color: var(--text-primary);
  border-color: var(--border-strong);
  box-shadow:
    0 16rpx 34rpx rgba(43, 38, 34, 0.13),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}
.learn__button--press {
  opacity: 0.86;
  box-shadow: 0 8rpx 20rpx rgba(35, 34, 32, 0.13);
}

/* Radiant v2: focused learning surface */
.learn {
  --page-accent: var(--amber-500);
  --page-accent-deep: var(--amber-700);
  --page-accent-wash: rgba(199, 121, 36, 0.12);
  background:
    radial-gradient(circle at 50% 0%, rgba(241, 181, 143, 0.22), transparent 38%),
    var(--surface-canvas);
}

.learn.is-review-mode {
  --page-accent: var(--coral-500);
  --page-accent-deep: var(--coral-700);
  --page-accent-wash: rgba(196, 97, 82, 0.12);
  background:
    radial-gradient(circle at 50% 0%, rgba(220, 155, 143, 0.20), transparent 38%),
    var(--surface-canvas);
}

.learn > study-hero {
  --study-hero-bar-height: 88rpx;
  --study-hero-progress-top: 78rpx;
  --study-hero-progress-width: 240rpx;
  --study-hero-heading-margin-top: 22rpx;
  --study-hero-heading-padding-x: 24rpx;
  --study-hero-heading-padding-bottom: 22rpx;
  --study-hero-heading-justify: center;
  --word-heading-align: center;
  --word-heading-title-justify: center;
  --word-heading-word-size: 68rpx;
  --word-heading-pron-align: center;
  --word-heading-width: 100%;
  --word-heading-text-align: center;
}

.learn__meta {
  height: 88rpx;
  gap: 10rpx;
}

.learn__mode-label {
  color: rgba(29, 29, 27, 0.5);
  font-size: 20rpx;
  font-weight: 600;
}

.learn__meta-divider {
  width: 4rpx;
  height: 4rpx;
  flex: 0 0 4rpx;
  border-radius: 50%;
  background: rgba(29, 29, 27, 0.28);
}

.learn__progress-text {
  color: #C97863;
  font-size: 22rpx;
  /* font-weight: 700; */
}

.learn__card-wrap {
  padding: 0 4rpx;
}

.learn .word-card__quiz {
  gap: 16rpx;
  margin-top: 32rpx;
}

.learn .word-card__option,
.learn .word-card__option.is-detail {
  height: 136rpx;
  min-height: 136rpx;
  border-radius: var(--radius-card);
  background: rgba(255, 252, 247, 0.90);
  border-color: var(--color-border);
  box-shadow: var(--shadow-soft);
}

.learn .word-card__option:active {
  transform: scale(0.985);
  border-color: var(--page-accent);
}

.learn .word-card__option.is-selected {
  background: var(--page-accent-wash);
  border-color: var(--page-accent);
}

.learn .word-card__option.is-correct {
  background: var(--color-success-bg);
  border-color: rgba(54, 116, 85, 0.34);
}

.learn .word-card__option.is-wrong {
  background: var(--color-error-bg);
  border-color: rgba(163, 70, 61, 0.34);
}

.learn__actions {
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

.learn__answer-button,
.learn__view-button {
  min-height: var(--button-height);
  border-radius: var(--button-radius);
  box-shadow: 0 14rpx 30rpx rgba(44, 42, 38, 0.12);
}

.learn__answer-button {
  background: var(--surface-paper);
  border-color: var(--color-border-strong);
}

.learn__view-button {
  background: var(--button-primary-bg);
}

.learn__empty {
  padding-left: 4rpx;
  padding-right: 4rpx;
}

.learn__completion-head,
.learn__stats,
.learn__history-item {
  border-radius: var(--radius-card);
}

.learn__stats {
  background: rgba(255, 252, 247, 0.88);
  border-color: var(--color-border);
  box-shadow: var(--shadow-soft);
}
