.favorites {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: transparent;
}

.favorites__bar {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0;
}
.favorites__bar-spacer {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}
.favorites__title {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 850;
  color: rgba(26, 26, 26, 0.72);
  line-height: 1.3;
}

.favorites__list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.favorites__swipe {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}
.favorites__delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  width: 0;
  background: #d9483f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  white-space: nowrap;
  transition: width 160ms ease, opacity 120ms ease;
}
.favorites__item {
  position: relative;
  z-index: 1;
  min-height: 164rpx;
  padding: 24rpx 26rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(26, 26, 26, 0.06);
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 26rpx rgba(22, 22, 22, 0.045);
  display: flex;
  flex-direction: column;
  gap: 9rpx;
}
.favorites__item--press {
  background: rgba(255, 250, 246, 0.96);
}
.favorites__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}
.favorites__word {
  min-width: 0;
  max-width: 315rpx;
  flex-shrink: 1;
  font-size: 36rpx;
  font-weight: 850;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorites__audio-group {
  min-width: 0;
  max-width: 262rpx;
  flex-shrink: 0;
  padding: 5rpx 7rpx 5rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 26, 0.045);
  border: 1rpx solid rgba(26, 26, 26, 0.055);
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.favorites__phonetic {
  min-width: 0;
  max-width: 198rpx;
  font-size: 21rpx;
  color: rgba(26, 26, 26, 0.52);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorites__play {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
}
.favorites__play:active {
  transform: scale(0.94);
  opacity: 0.78;
}
.favorites__play-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
}
.favorites__translation {
  min-width: 0;
  font-size: 25rpx;
  color: rgba(26, 26, 26, 0.68);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.favorites__meta-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  line-height: 1.35;
}
.favorites__extra {
  min-width: 0;
  flex: 0 1 62%;
  box-sizing: border-box;
  font-size: 21rpx;
  color: rgba(26, 26, 26, 0.42);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorites__time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 20rpx;
  color: rgba(26, 26, 26, 0.34);
  line-height: 1.35;
  white-space: nowrap;
}
.favorites__state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  text-align: center;
}
.favorites__empty-title {
  font-size: 34rpx;
  font-weight: 850;
  color: var(--color-ink);
}
