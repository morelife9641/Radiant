.favorites {
  --favorites-item-bg: rgba(253, 251, 247, 0.86);
  --favorites-item-border: var(--border-subtle);
  --favorites-item-shadow: 0 5rpx 16rpx rgba(44, 42, 38, 0.045);
  --favorites-item-radius: var(--radius-card);
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: 72rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
  background: linear-gradient(180deg, #F1DED5 0%, #F0EFEB 30%, #E7EAE8 100%);
}

.favorites__bar {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0;
  border-bottom: 0;
}
.favorites__title {
  min-width: 0;
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}
.favorites__sort-picker {
  flex-shrink: 0;
}
.favorites__sort-control {
  height: 48rpx;
  padding: 0 14rpx 0 16rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.09);
  border-radius: var(--radius-pill);
  background: rgba(255, 252, 247, 0.64);
  display: flex;
  align-items: center;
  gap: 9rpx;
  box-sizing: border-box;
}
.favorites__sort-label {
  color: rgba(26, 26, 26, 0.62);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}
.favorites__sort-chevron {
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-right: 2rpx solid rgba(26, 26, 26, 0.5);
  border-bottom: 2rpx solid rgba(26, 26, 26, 0.5);
  transform: rotate(45deg);
}

.favorites__content {
  padding-top: 12rpx;
}

.favorites__list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.favorites__swipe {
  position: relative;
  overflow: hidden;
  border-radius: var(--favorites-item-radius);
}
.favorites__delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  width: 0;
  background: #d9483f;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  white-space: nowrap;
  transition: width 160ms ease, opacity 120ms ease;
}
.favorites__item {
  position: relative;
  z-index: 1;
  height: 244rpx;
  padding: 18rpx 24rpx 16rpx;
  background: var(--favorites-item-bg);
  border: 1rpx solid var(--favorites-item-border);
  border-radius: var(--favorites-item-radius);
  box-sizing: border-box;
  box-shadow: var(--favorites-item-shadow);
  display: grid;
  grid-template-rows: 92rpx 30rpx 48rpx 22rpx;
  row-gap: 6rpx;
  overflow: hidden;
}
.favorites__item--press {
  background: rgba(255, 248, 242, 0.94);
  border-color: rgba(128, 51, 38, 0.2);
  box-shadow: 0 7rpx 18rpx rgba(80, 52, 43, 0.07);
}
.favorites__head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  min-width: 0;
}
.favorites__title-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  width: 100%;
}
.favorites__word {
  min-width: 0;
  max-width: calc(100% - 36rpx);
  padding: 0 0 2rpx;
  margin: 0 0 -2rpx;
  box-sizing: border-box;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.16;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorites__pron-row {
  min-width: 0;
  max-width: 100%;
  height: 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 6rpx 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 26, 0.045);
  border: 1rpx solid rgba(26, 26, 26, 0.055);
}
.favorites__phonetic {
  min-width: 0;
  max-width: 260rpx;
  padding: 0;
  font-size: 20rpx;
  color: rgba(26, 26, 26, 0.45);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.favorites__play {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.favorites__play:active {
  transform: scale(0.94);
  opacity: 0.78;
}
.favorites__play-icon {
  width: 18rpx;
  height: 18rpx;
  display: block;
  opacity: 0.72;
}
.favorites__translation-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
}
.favorites__translation-pos {
  flex-shrink: 0;
  color: rgba(218, 78, 70, 0.72);
  font-size: 24rpx;
  font-weight: 760;
}
.favorites__translation {
  min-width: 0;
  flex: 1;
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.86);
  font-weight: 580;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.favorites__definition-row {
  min-width: 0;
  height: 48rpx;
  padding-top: 5rpx;
  border-top: 0;
  box-sizing: border-box;
  overflow: hidden;
}
.favorites__definition {
  display: -webkit-box;
  min-width: 0;
  font-size: 22rpx;
  color: rgba(26, 26, 26, 0.52);
  font-weight: 400;
  line-height: 26rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.favorites__meta-row {
  min-width: 0;
  height: 22rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  line-height: 22rpx;
}
.favorites__time {
  flex-shrink: 0;
  font-size: 19rpx;
  color: rgba(26, 26, 26, 0.4);
  line-height: 22rpx;
  white-space: nowrap;
}
.favorites__state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
}
.favorites__empty-icon {
  width: 56rpx;
  height: 56rpx;
  display: block;
  margin-bottom: 6rpx;
}
.favorites__empty-title {
  font-size: 34rpx;
  font-weight: 780;
  color: var(--color-ink);
}
.favorites__empty-action {
  min-width: 196rpx;
  height: 72rpx;
  margin-top: 16rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--ink-950);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 10rpx 22rpx rgba(26, 26, 26, 0.14);
}
.favorites__empty-action--press {
  opacity: 0.84;
}
