<view class="page favorites" style="padding-top: {{navTopPx}}px">
  <view wx:if="{{sortMenuVisible}}" class="favorites__sort-scrim {{sortMenuOpen ? 'is-open' : ''}}" catchtap="onCloseSortMenu"></view>
  <view class="favorites__bar" bindtap="onCloseSortMenu">
    <r-back-button bind:back="onBack" />
    <text class="favorites__title">收藏</text>
    <view class="favorites__sort-picker">
      <view class="favorites__sort-control {{sortMenuVisible ? 'is-open' : ''}}" catchtap="onToggleSortMenu" aria-label="选择收藏排序" aria-expanded="{{sortMenuOpen}}">
        <text wx:if="{{!sortMenuVisible}}" class="favorites__sort-label">{{sortLabel}}</text>
        <view class="favorites__sort-chevron"></view>
      </view>
      <view wx:if="{{sortMenuVisible}}" class="favorites__sort-menu {{sortMenuOpen ? 'is-open' : ''}}">
        <view
          wx:for="{{sortOptions}}"
          wx:key="*this"
          class="favorites__sort-menu-item {{index === sortIndex ? 'is-selected' : ''}}"
          data-sort-index="{{index}}"
          catchtap="onSelectSort"
        >
          <text>{{item}}</text>
          <view wx:if="{{index === sortIndex}}" class="favorites__sort-menu-mark"></view>
        </view>
      </view>
    </view>
  </view>

  <r-loading wx:if="{{loading}}" fill title="正在整理收藏" />

  <view wx:elif="{{!items.length}}" class="favorites__state">
    <image class="favorites__empty-icon" src="/assets/icons/star-favorite.svg" mode="aspectFit" />
    <text class="favorites__empty-title">还没有收藏词</text>
    <text class="caption muted">在学习或详情页点亮星标后会出现在这里</text>
    <view class="favorites__empty-action" bindtap="onGoLearn" hover-class="favorites__empty-action--press" hover-stay-time="80">去学习</view>
  </view>

  <view wx:else class="favorites__content">
    <view class="favorites__list">
      <view
        wx:for="{{items}}"
        wx:key="wordId"
        wx:for-item="item"
        wx:for-index="index"
        class="favorites__swipe"
        data-index="{{index}}"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        bindtouchcancel="onTouchEnd"
      >
        <view
          class="favorites__delete"
          style="width: {{item.actionWidth}}px; opacity: {{item.actionWidth ? 1 : 0}};"
          data-index="{{index}}"
          catchtap="onRequestCancelFavorite"
        >取消收藏</view>
        <view
          class="favorites__item"
          data-word="{{item.word}}"
          bindtap="onOpenWord"
          hover-class="favorites__item--press"
          hover-stay-time="60"
        >
          <view class="favorites__head">
            <view class="favorites__title-row">
              <text class="favorites__word">{{item.word}}</text>
              <view class="favorites__favorite-control" data-index="{{index}}" catchtap="onRequestCancelFavorite" aria-label="取消收藏">
                <image class="favorites__favorite-icon" src="/assets/icons/star-favorite-filled.svg" mode="aspectFit" />
              </view>
            </view>
            <view class="favorites__pron-row">
              <text wx:if="{{item.phoneticText}}" class="favorites__phonetic">{{item.phoneticText}}</text>
              <view class="favorites__play" data-word="{{item.word}}" catchtap="onPlayWord" aria-label="播放发音">
                <image class="favorites__play-icon" src="/assets/icons/ear.svg" mode="aspectFit" />
              </view>
            </view>
          </view>
          <view class="favorites__translation-line">
            <view class="favorites__translation-copy">
              <text wx:if="{{item.posText}}" class="favorites__translation-pos">{{item.posText}}</text>
              <text class="favorites__translation">{{item.translationText}}</text>
            </view>
            <text class="favorites__time">{{item.favoriteTimeText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
