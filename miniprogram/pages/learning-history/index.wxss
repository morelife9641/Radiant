.history-page {
  position: relative;
  min-height: 100vh;
  padding: 0 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F3DDD3 0%, #F0EEE9 34%, #E6EAE8 100%);
  color: var(--text-primary);
}

.history-page__bar {
  position: relative;
  z-index: 2;
  min-height: 70rpx;
  display: flex;
  align-items: center;
}
.history-page__bar-spacer {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}
.history-page__bar-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.history-page__title {
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.3;
  color: rgba(33, 30, 28, 0.86);
}
.history-page__subtitle {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.3;
  color: rgba(75, 57, 50, 0.43);
}

.history-page__streak-summary {
  position: relative;
  z-index: 1;
  min-height: 70rpx;
  padding: 4rpx 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.history-page__streak-light {
  width: 12rpx;
  height: 12rpx;
  margin-right: 3rpx;
  border-radius: 50%;
  background: #FF8A68;
  box-shadow: 0 0 10rpx rgba(255, 115, 86, 0.68), 0 0 26rpx rgba(255, 157, 101, 0.42);
}
.history-page__streak-number {
  font-size: 34rpx;
  font-weight: 880;
  line-height: 1;
  color: #201D1B;
}
.history-page__streak-copy {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(33, 30, 28, 0.68);
}
.history-page__streak-divider {
  margin: 0 3rpx;
  color: rgba(33, 30, 28, 0.2);
  font-size: 22rpx;
}
.history-page__streak-note {
  font-size: 19rpx;
  font-weight: 630;
  color: rgba(33, 30, 28, 0.4);
}

.history-page__metrics {
  position: relative;
  z-index: 1;
  min-height: 78rpx;
  margin: 0 0 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.history-page__metric {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.history-page__metric-value {
  font-size: 31rpx;
  font-weight: 850;
  color: rgba(33, 30, 28, 0.88);
  line-height: 1.2;
}
.history-page__metric-label {
  font-size: 19rpx;
  font-weight: 650;
  color: rgba(33, 30, 28, 0.38);
  line-height: 1.3;
}

.history-page__trend {
  position: relative;
  z-index: 1;
  padding: 26rpx 24rpx 20rpx;
  border-radius: 16rpx;
  background: var(--surface-card);
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-soft);
}
.history-page__range {
  height: 48rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  display: flex;
  flex-shrink: 0;
  margin-left: auto;
}
.history-page__range-item {
  min-width: 66rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(33, 30, 28, 0.42);
  font-size: 19rpx;
  font-weight: 720;
  line-height: 1;
  transition: color 160ms ease, background 160ms ease, box-shadow 160ms ease;
}
.history-page__range-item.is-active {
  background: var(--surface-card-solid);
  color: var(--coral-700);
  box-shadow: 0 4rpx 12rpx rgba(74, 49, 42, 0.08);
}
.history-page__range-item--press {
  opacity: 0.72;
}
.history-page__selected {
  min-height: 88rpx;
  margin-top: 19rpx;
  padding: 13rpx 16rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(241, 221, 215, 0.78), rgba(252, 250, 246, 0.5));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.history-page__selected > view {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.history-page__selected-date {
  font-size: 22rpx;
  font-weight: 800;
  color: rgba(33, 30, 28, 0.74);
}
.history-page__selected-copy {
  max-width: 470rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: rgba(33, 30, 28, 0.4);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.history-page__selected-value {
  flex-shrink: 0;
  font-size: 42rpx;
  font-weight: 880;
  color: #D95047;
  line-height: 1;
}
.history-page__chart-wrap {
  margin-top: 8rpx;
}
.history-page__chart {
  width: 100%;
  height: 238rpx;
  display: block;
}
.history-page__chart-labels {
  height: 30rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(33, 30, 28, 0.34);
  font-size: 18rpx;
  font-weight: 630;
  line-height: 1;
}

.history-page__records {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}
.history-page__record-list {
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(57, 45, 40, 0.09);
}
.history-page__record {
  min-height: 112rpx;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid rgba(57, 45, 40, 0.09);
  display: grid;
  grid-template-columns: 118rpx minmax(0, 1fr) 72rpx;
  align-items: center;
  gap: 14rpx;
}
.history-page__record-date,
.history-page__record-main,
.history-page__record-total {
  display: flex;
  flex-direction: column;
}
.history-page__record-day {
  font-size: 23rpx;
  font-weight: 800;
  color: rgba(33, 30, 28, 0.74);
}
.history-page__record-week {
  font-size: 18rpx;
  font-weight: 620;
  color: rgba(33, 30, 28, 0.34);
}
.history-page__record-main {
  min-width: 0;
}
.history-page__record-title {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(33, 30, 28, 0.82);
}
.history-page__record-detail {
  max-width: 100%;
  margin-top: 2rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: rgba(33, 30, 28, 0.38);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.history-page__record-total {
  align-items: flex-end;
  color: #D95A4C;
}
.history-page__record-total text:first-child {
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.1;
}
.history-page__record-total text:last-child {
  font-size: 17rpx;
  font-weight: 650;
  color: rgba(33, 30, 28, 0.32);
}
.history-page__empty {
  min-height: 300rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid rgba(57, 45, 40, 0.09);
  border-bottom: 1rpx solid rgba(57, 45, 40, 0.09);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.history-page__empty-light {
  width: 30rpx;
  height: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: #FF9B78;
  box-shadow: 0 0 0 10rpx rgba(255, 155, 120, 0.12), 0 0 34rpx rgba(255, 116, 84, 0.3);
}
.history-page__empty-title {
  font-size: 26rpx;
  font-weight: 820;
  color: rgba(33, 30, 28, 0.72);
}
.history-page__empty-copy {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(33, 30, 28, 0.34);
}
.history-page__data-note {
  position: relative;
  z-index: 1;
  display: block;
  margin: 28rpx 12rpx 0;
  text-align: center;
  color: rgba(33, 30, 28, 0.3);
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.5;
}
