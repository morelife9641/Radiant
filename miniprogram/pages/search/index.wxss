.search {
  min-height: 100vh;
  padding-top: 0;
  padding-bottom: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  background: linear-gradient(180deg, #F2DED4 0%, #F0EEE9 34%, #E6EAE8 100%);
}

.search__bar {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 2rpx 0;
}
.search__bar-spacer {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}
.search__title {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 850;
  color: var(--text-primary);
  line-height: 1.3;
}

.search__box {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.search__input-wrap {
  height: 76rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surface-card-solid);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
}

.search__icon {
  width: 30rpx;
  height: 30rpx;
  color: rgba(26, 26, 26, 0.48);
  display: block;
  flex-shrink: 0;
}

.search__input {
  min-width: 0;
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--color-ink);
  font-weight: 650;
}

.search__clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(26, 26, 26, 0.06);
  color: rgba(26, 26, 26, 0.54);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
}

.search__list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border-radius: var(--radius-card);
  background: var(--surface-card);
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.search__item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
  background: transparent;
  border-top: 1rpx solid rgba(26, 26, 26, 0.065);
  border-radius: 0;
  box-shadow: none;
}
.search__item:first-child {
  border-top: 0;
}

.search__item--press {
  background: var(--surface-pressed);
}

.search__item-main {
  min-width: 0;
  width: 270rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.search__word-row {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  min-width: 0;
}

.search__word {
  min-width: 0;
  font-size: 35rpx;
  font-weight: 800;
  color: var(--color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search__phonetic {
  font-size: 22rpx;
  color: var(--color-graphite);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search__translation {
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.45;
  text-align: right;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.search__state {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-1);
  text-align: center;
}

.search__empty-title {
  font-size: 34rpx;
  font-weight: 850;
  color: var(--color-ink);
}
