<view class="page profile">
  <r-navbar title="" showBack="{{false}}" />
  <view class="profile__head card">
    <view class="profile__avatar">{{avatarLetter}}</view>
    <view class="col gap-1" style="flex:1">
      <text class="profile__name">{{nickname}}</text>
      <text class="caption muted">连续打卡 {{streakDays}} 天</text>
    </view>
  </view>

  <view class="profile__list card">
    <view class="profile__item" bindtap="onSearch">
      <text>搜索单词</text><text class="caption muted">›</text>
    </view>
    <view wx:if="{{false}}" class="profile__item" bindtap="onWordbookList">
      <text>词书库</text><text class="caption muted">›</text>
    </view>
    <view class="profile__item" bindtap="onMastered">
      <text>已认识单词</text><text class="caption muted">›</text>
    </view>
    <view class="profile__item" bindtap="onWrongbook">
      <text>错词本</text><text class="caption muted">›</text>
    </view>
    <view class="profile__item" bindtap="onSettings">
      <text>设置</text><text class="caption muted">›</text>
    </view>
  </view>
</view>
