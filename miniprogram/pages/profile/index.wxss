.profile {
  padding-top: var(--space-4);
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.profile__head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.profile__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 800;
  border: 4rpx solid var(--color-primary-light);
}
.profile__name { font-size: 36rpx; font-weight: 700; color: var(--color-ink); }

.profile__list { padding: 0; }
.profile__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4);
  border-bottom: 2rpx solid var(--color-hairline);
  font-size: 30rpx;
  color: var(--color-ink);
}
.profile__item:last-child { border-bottom: none; }
