<view class="page onboarding">
  <r-navbar title="" showBack="{{false}}" />
  <view class="onboarding__step muted">Step 1 / 3</view>
  <text class="h1 onboarding__title">你想用 Radiant 学什么？</text>
  <text class="onboarding__sub muted">之后可以随时在设置里修改</text>

  <view class="picker">
    <view
      wx:for="{{options}}"
      wx:key="key"
      class="picker__card {{selected === item.key ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelect"
      hover-class="picker__card--press"
      hover-stay-time="60"
    >
      <text class="picker__emoji">{{item.emoji}}</text>
      <text class="picker__title">{{item.title}}</text>
      <text class="picker__desc muted">{{item.desc}}</text>
    </view>
  </view>

  <view class="onboarding__footer safe-bottom">
    <r-button type="primary" block disabled="{{!selected}}" bind:tap="onNext">下一步</r-button>
  </view>
</view>
