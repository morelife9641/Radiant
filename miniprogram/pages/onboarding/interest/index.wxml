<view class="page onboarding">
  <r-navbar title="" />
  <view class="onboarding__step muted">Step 3 / 3</view>
  <text class="h1 onboarding__title">你都对什么感兴趣？</text>
  <text class="onboarding__sub muted">用于优先展示你感兴趣的场景例句，可多选</text>

  <view class="chips">
    <view
      wx:for="{{options}}"
      wx:key="key"
      class="chips__item {{selected[item.key] ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onToggle"
      hover-class="chips__item--press"
      hover-stay-time="60"
    >
      <text class="chips__emoji">{{item.emoji}}</text>
      <text class="chips__label">{{item.label}}</text>
    </view>
  </view>

  <view class="onboarding__footer safe-bottom">
    <r-button type="primary" block disabled="{{selectedCount === 0}}" bind:tap="onDone">开始使用</r-button>
  </view>
</view>
