<view class="page onboarding">
  <r-navbar title="" />
  <view class="onboarding__step muted">Step 2 / 3</view>
  <text class="h1 onboarding__title">挑一本词书开始</text>
  <text class="onboarding__sub muted">之后可以随时切换或收藏多本</text>

  <view class="books">
    <view wx:if="{{!books.length}}" class="books__empty">
      <text>暂无已上线词书</text>
    </view>

    <view
      wx:for="{{books}}"
      wx:key="id"
      class="books__item {{selected === item.id ? 'is-active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelect"
      hover-class="books__item--press"
      hover-stay-time="60"
    >
      <view class="books__cover" style="background:{{item.coverColor}}">
        <image wx:if="{{item.coverImage}}" class="books__cover-image" src="{{item.coverImage}}" mode="aspectFill" data-id="{{item.id}}" binderror="onCoverError" />
        <text wx:else class="books__cover-letter">{{item.letter}}</text>
      </view>
      <view class="books__info col gap-1">
        <text class="books__name">{{item.name}}</text>
        <view class="row gap-1">
          <r-tag text="{{item.progressText}}" type="primary" />
        </view>
      </view>
    </view>
  </view>

  <view class="onboarding__footer safe-bottom">
    <r-button type="primary" block disabled="{{!selected}}" bind:tap="onNext">下一步</r-button>
  </view>
</view>
