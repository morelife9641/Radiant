.books {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.books__empty {
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-white);
  box-shadow: var(--shadow-soft);
  color: var(--color-graphite);
  font-size: 28rpx;
}
.books__item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3);
  background: var(--color-white);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  border: 4rpx solid transparent;
  transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast);
}
.books__item.is-active { border-color: var(--color-primary); background: var(--color-primary-light); }
.books__item--press { transform: scale(0.98); }

.books__cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.books__cover-image {
  width: 100%;
  height: 100%;
  display: block;
}
.books__cover-letter {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-white);
}

.books__info { flex: 1; }
.books__name { font-size: 32rpx; font-weight: 700; color: var(--color-ink); }
