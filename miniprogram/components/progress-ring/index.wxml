<view class="ring" style="width:{{size}}rpx;height:{{size}}rpx">
  <view class="ring__track"></view>
  <view class="ring__fill" style="background:conic-gradient(var(--color-primary) {{percent * 360}}deg, var(--color-hairline) 0)"></view>
  <view class="ring__center">
    <view class="ring__fraction">
      <text class="ring__value">{{displayValue}}</text>
      <text class="ring__total muted">/ {{displayTotal}}</text>
    </view>
  </view>
</view>
