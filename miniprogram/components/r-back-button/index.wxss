.r-back-button {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--surface-card-solid, rgba(255, 255, 255, 0.86));
  border: 1rpx solid var(--border-subtle, rgba(48, 48, 44, 0.12));
  box-shadow: 0 6rpx 16rpx rgba(44, 42, 38, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 140ms ease, opacity 140ms ease, background 140ms ease;
}

.r-back-button--press {
  opacity: 0.76;
  background: var(--surface-pressed, rgba(55, 55, 51, 0.09));
}

.r-back-button__icon {
  width: 18rpx;
  height: 18rpx;
  display: block;
}
