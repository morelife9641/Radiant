.word-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.word-heading__title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 0;
  min-height: 70rpx;
}

.word-heading__word {
  min-width: 0;
  max-width: calc(100% - 36rpx);
  padding: 0 0 2rpx;
  margin: 0 0 -2rpx;
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-size: 62rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.16;
  flex: 0 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -webkit-font-smoothing: antialiased;
}

.word-heading__recovery {
  display: inline-flex;
  flex-direction: column-reverse;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 14rpx;
  height: 40rpx;
  padding: 0 3rpx;
  flex-shrink: 0;
}

.word-heading__recovery-dot {
  width: 4rpx;
  height: 8rpx;
  border: 0;
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(26, 26, 26, 0.13);
  opacity: 0.7;
}

.word-heading__recovery-dot.is-active {
  width: 4rpx;
  height: 8rpx;
  border: 0;
  background: linear-gradient(180deg, #FFB39A 0%, #E96B5A 100%);
  opacity: 1;
  box-shadow: 0 0 8rpx rgba(233, 107, 90, 0.3);
}

.word-heading__pron-row {
  display: flex;
  align-items: center;
  align-self: flex-start;
  gap: 6rpx;
  max-width: 100%;
  padding: 5rpx 7rpx 5rpx 13rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.055);
  border-radius: 999rpx;
  box-sizing: border-box;
  background: rgba(26, 26, 26, 0.045);
}

.word-heading__phonetic {
  min-width: 0;
  max-width: 260rpx;
  color: rgba(26, 26, 26, 0.52);
  font-family: "SF Pro", "Helvetica Neue", sans-serif;
  font-size: 21rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-heading__play {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  flex-shrink: 0;
}

.word-heading__play:active {
  transform: scale(0.94);
  opacity: 0.78;
}

.word-heading__play-icon {
  display: block;
  width: 22rpx;
  height: 22rpx;
}

.word-heading__translations {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  width: 100%;
  min-width: 0;
  padding: 4rpx 0 2rpx;
}

.word-heading__translation-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
}

.word-heading__translation-pos {
  color: rgba(218, 78, 70, 0.72);
  font-size: 24rpx;
  font-weight: 760;
  overflow-wrap: break-word;
  flex-shrink: 0;
}

.word-heading__translation-text {
  min-width: 0;
  flex: 1;
  color: rgba(26, 26, 26, 0.86);
  font-size: 24rpx;
  font-weight: 580;
  overflow: hidden;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
