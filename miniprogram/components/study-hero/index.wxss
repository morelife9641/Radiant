.study-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
}

.study-hero__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0;
  box-sizing: border-box;
  flex: 0 0 72rpx;
}

.study-hero__back,
.study-hero__actions {
  display: flex;
  align-items: center;
  width: 90rpx;
  height: 72rpx;
  flex: 0 0 90rpx;
}

.study-hero__back {
  justify-content: flex-start;
}

.study-hero__actions {
  justify-content: flex-end;
}

.study-hero__center {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  flex: 1;
}

.study-hero__progress {
  position: absolute;
  left: 50%;
  top: 64rpx;
  width: 180rpx;
  height: 4rpx;
  transform: translateX(-50%);
  border-radius: var(--radius-pill);
  background: var(--study-progress-track, rgba(26, 26, 26, 0.08));
  overflow: hidden;
}

.study-hero__progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--study-progress-fill, rgba(230, 57, 70, 0.78));
  box-shadow: 0 0 12rpx var(--study-progress-glow, rgba(230, 57, 70, 0.18));
  transition: width var(--dur-base) var(--ease-out);
}

.study-hero__heading {
  width: 100%;
  min-width: 0;
  margin-top: 10rpx;
}
