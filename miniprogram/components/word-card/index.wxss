.word-card {
  min-height: 0;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  border: 0;
}

.word-card__head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.word-card__recovery {
  display: inline-flex;
  flex-direction: column-reverse;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 14rpx;
  height: 40rpx;
  padding: 0 3rpx;
  flex-shrink: 0;
}
.word-card__recovery-dot {
  width: 4rpx;
  height: 8rpx;
  border-radius: 999rpx;
  border: 0;
  background: rgba(26, 26, 26, 0.13);
  box-sizing: border-box;
  opacity: 0.7;
}
.word-card__recovery-dot.is-active {
  width: 4rpx;
  height: 8rpx;
  border: 0;
  background: linear-gradient(180deg, #FFB39A 0%, #E96B5A 100%);
  opacity: 1;
  box-shadow: 0 0 8rpx rgba(233, 107, 90, 0.3);
}
.word-card__title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-height: 82rpx;
}
.word-card__word {
  min-width: 0;
  max-width: calc(100% - 36rpx);
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0;
  line-height: 1.16;
  padding: 0 0 6rpx;
  margin-bottom: -6rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  flex: 0 1 auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.word-card__pron-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  align-self: flex-start;
  max-width: 100%;
  min-height: 46rpx;
  padding: 5rpx 7rpx 5rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(26, 26, 26, 0.045);
  border: 1rpx solid rgba(26, 26, 26, 0.055);
  box-sizing: border-box;
}
.word-card__play {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.word-card__play:active {
  transform: scale(0.94);
  opacity: 0.78;
}
.word-card__play-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
}
.word-card__phonetic {
  min-width: 0;
  max-width: 260rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: rgba(26, 26, 26, 0.52);
  font-family: "SF Pro", "Helvetica Neue", sans-serif;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.word-card__prompt {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 8rpx;
}
.word-card__prompt-line {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  min-width: 0;
  max-width: 100%;
}
.word-card__prompt-pos {
  flex: 0 0 auto;
  color: var(--word-card-meta-color, rgba(26, 26, 26, 0.52));
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}
.word-card__prompt-main {
  position: relative;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  cursor: pointer;
}
.word-card__prompt-text {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 20rpx;
  color: var(--color-ink);
  line-height: 1.34;
  white-space: normal;
  word-break: normal;
  overflow-wrap: break-word;
  overflow: visible;
  text-overflow: clip;
  -webkit-font-smoothing: antialiased;
}
.word-card__prompt-text.is-english {
  -webkit-hyphens: manual;
  hyphens: manual;
  -webkit-hyphenate-character: "-";
  hyphenate-character: "-";
}
.word-card__prompt-main.is-translatable {
  padding-bottom: 70rpx;
  box-sizing: border-box;
}
.word-card__prompt-translation {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: -webkit-box;
  width: 100%;
  max-width: 100%;
  height: 70rpx;
  margin: 0;
  color: rgba(26, 26, 26, 0.52);
  font-size: 25rpx;
  font-weight: 620;
  line-height: 1.38;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  opacity: 0;
  transition: opacity 180ms ease;
}
.word-card__prompt-main.is-translation-visible .word-card__prompt-translation {
  opacity: 1;
}
.word-card__letters {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}
.word-card__letter {
  width: 44rpx;
  height: 52rpx;
  border-radius: 10rpx;
  background: rgba(26, 26, 26, 0.06);
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
}
.word-card__letter.is-blank {
  background: transparent;
  border: 2rpx solid rgba(26, 26, 26, 0.18);
}

.word-card__quiz {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-start;
}
.word-card.is-heading-external .word-card__quiz {
  padding-top: 12rpx;
  box-sizing: border-box;
}
.word-card__option {
  position: relative;
  height: 156rpx;
  min-height: 156rpx;
  padding: 16rpx 24rpx 15rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card, 16rpx);
  background: var(--word-card-option-bg, #FFF9F1);
  border: 1rpx solid var(--word-card-option-border, rgba(38, 34, 31, 0.12));
  box-shadow:
    var(--word-card-option-shadow, 0 8rpx 20rpx rgba(47, 44, 40, 0.075));
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}
.word-card__option.is-selected {
  background: var(--word-card-selected-bg, #FFE7CD);
  border-color: var(--word-card-selected-border, var(--word-card-focus, rgba(38, 34, 31, 0.4)));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}
.word-card__option.is-correct {
  background: var(--word-card-correct-bg, var(--state-success-bg, #DDECE3));
  border-color: var(--word-card-correct-border, rgba(54, 116, 85, 0.48));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}
.word-card__option.is-wrong {
  background: var(--word-card-selected-wrong-bg, var(--state-error-bg, #F2DDD8));
  border-color: var(--word-card-selected-wrong-border, rgba(163, 70, 61, 0.62));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}
.word-card__option.is-selected.is-correct {
  background: var(--word-card-selected-correct-bg, #D1EBDD);
  border-color: var(--word-card-selected-correct-border, #377D59);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}
.word-card__option.is-selected.is-wrong {
  background: var(--word-card-selected-wrong-bg, #F5D6CF);
  border-color: var(--word-card-selected-wrong-border, #B95749);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.68);
}
.word-card__option.is-detail {
  height: 156rpx;
  min-height: 156rpx;
}
.word-card__option-pos {
  display: block;
  align-self: flex-start;
  min-width: 0;
  max-width: 100%;
  flex: 0 0 auto;
  color: var(--word-card-option-meta-fg, var(--word-card-meta-color, rgba(26, 26, 26, 0.48)));
  background: transparent;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.word-card__option-content {
  width: 100%;
  min-width: 0;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 8rpx;
}
.word-card__option-face {
  width: 100%;
  min-width: 0;
}
.word-card__option-face--detail {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  pointer-events: none;
}
.word-card__option.is-detail .word-card__option-face--front {
  display: none;
}
.word-card__option.is-detail .word-card__option-face--detail {
  display: flex;
}
.word-card__option-text {
  display: block;
  width: 100%;
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, var(--color-ink));
  line-height: 1.34;
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}
.word-card__option-word {
  display: block;
  max-width: 100%;
  color: var(--text-primary, var(--color-ink));
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.24;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -webkit-font-smoothing: antialiased;
}
.word-card__option-translation {
  display: -webkit-box;
  width: 100%;
  max-width: 100%;
  color: var(--text-secondary, rgba(26, 26, 26, 0.56));
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.27;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  overflow-wrap: break-word;
}
.word-card__spelling {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.word-card__input {
  height: 104rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.74);
  border: 1rpx solid rgba(26, 26, 26, 0.065);
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 780;
  letter-spacing: 0;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78),
    0 8rpx 22rpx rgba(26, 26, 26, 0.04);
}
.word-card__input.is-correct {
  background: rgba(34, 197, 94, 0.1);
  border-color: rgba(34, 197, 94, 0.38);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 0 0 6rpx rgba(34, 197, 94, 0.055);
}
.word-card__input.is-wrong {
  background: rgba(230, 57, 70, 0.08);
  border-color: rgba(230, 57, 70, 0.32);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 0 0 6rpx rgba(230, 57, 70, 0.055);
}
