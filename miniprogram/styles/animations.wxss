@keyframes r-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes r-slide-in-right {
  from { opacity: 0; transform: translateX(40rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes r-pop-in {
  0% { opacity: 0; transform: scale(0.92); }
  100% { opacity: 1; transform: scale(1); }
}

.r-fade-in { animation: r-fade-in var(--dur-base) var(--ease-out) both; }
.r-slide-in { animation: r-slide-in-right var(--dur-base) var(--ease-out) both; }
.r-pop-in { animation: r-pop-in var(--dur-base) var(--ease-out) both; }
