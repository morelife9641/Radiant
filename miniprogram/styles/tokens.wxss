/* Radiant.AI design tokens: primitive -> semantic -> component. */
page {
  /* Primitive colors */
  --ink-950: #1D1D1B;
  --ink-800: #393936;
  --ink-600: #62625D;
  --ink-450: #898982;
  --neutral-300: #CFD1CC;
  --neutral-200: #DADCD7;
  --neutral-100: #E9EAE5;
  --neutral-50: #F4F4F0;
  --warm-50: #FFFCF7;
  --warm-100: #F7ECDE;
  --amber-500: #C77924;
  --amber-700: #8C4D16;
  --coral-100: #F1DDD7;
  --coral-500: #C46152;
  --coral-700: #903F36;
  --sage-100: #DDECE3;
  --sage-700: #367455;
  --rose-100: #F2DDD8;
  --rose-700: #A3463D;

  /* Semantic colors */
  --color-primary: var(--coral-500);
  --color-primary-deep: var(--coral-700);
  --color-primary-light: var(--coral-100);
  --color-white: #FFFFFF;
  --color-bg: var(--neutral-50);
  --color-ink: var(--ink-950);
  --color-graphite: var(--ink-600);
  --color-mist: var(--ink-450);
  --color-hairline: var(--neutral-200);
  --color-success: var(--sage-700);
  --color-warning: var(--amber-500);
  --color-error: var(--rose-700);

  --surface-canvas-top: #F5F1EB;
  --surface-canvas-mid: #F5F1EB;
  --surface-canvas-bottom: #F1EEE8;
  --surface-card: rgba(255, 252, 247, 0.94);
  --surface-card-solid: #FCFAF6;
  --surface-muted: rgba(55, 55, 51, 0.055);
  --surface-pressed: rgba(55, 55, 51, 0.09);
  --text-primary: var(--ink-950);
  --text-secondary: var(--ink-600);
  --text-tertiary: var(--ink-450);
  --border-subtle: rgba(48, 48, 44, 0.12);
  --border-strong: rgba(48, 48, 44, 0.22);
  --state-success-bg: var(--sage-100);
  --state-success-fg: var(--sage-700);
  --state-error-bg: var(--rose-100);
  --state-error-fg: var(--rose-700);

  /* Radiant v2 semantic aliases */
  --color-background: #F5F1EB;
  --color-foreground: var(--ink-950);
  --color-card: var(--warm-50);
  --color-card-foreground: var(--ink-950);
  --color-secondary: rgba(55, 55, 51, 0.055);
  --color-secondary-foreground: var(--ink-800);
  --color-muted-foreground: var(--ink-450);
  --color-border: rgba(48, 48, 44, 0.10);
  --color-border-strong: rgba(48, 48, 44, 0.20);
  --color-success-bg: var(--sage-100);
  --color-error-bg: var(--rose-100);
  --surface-paper: #FFFCF7;
  --surface-canvas: #F5F1EB;
  --surface-glow-warm: rgba(241, 181, 143, 0.18);
  --surface-glow-coral: rgba(196, 97, 82, 0.14);

  /* === Typography === */
  --font-h1: 56rpx;
  --font-h2: 40rpx;
  --font-h3: 32rpx;
  --font-body: 28rpx;
  --font-caption: 24rpx;
  --font-display: 96rpx;

  /* Spacing: 8rpx grid */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;

  --page-padding-x: 32rpx;

  --nav-h: 176rpx;

  /* Shape */
  --radius-card: 20rpx;
  --radius-btn: 16rpx;
  --radius-control: 12rpx;
  --radius-pill: 999rpx;

  /* Elevation */
  --shadow-soft: 0 8rpx 22rpx rgba(44, 42, 38, 0.065);
  --shadow-raised: 0 16rpx 38rpx rgba(44, 42, 38, 0.11);
  --shadow-focus: 0 0 0 4rpx rgba(140, 77, 22, 0.1);

  /* Component tokens */
  --card-bg: var(--surface-paper);
  --card-border: var(--color-border);
  --card-radius: var(--radius-card);
  --card-padding: 24rpx;
  --card-shadow: var(--shadow-soft);
  --button-height: 84rpx;
  --button-radius: var(--radius-pill);
  --button-primary-bg: var(--ink-950);
  --button-primary-fg: var(--color-white);
  --pill-height: 52rpx;
  --page-nav-height: 88rpx;
  --page-accent: var(--coral-500);
  --page-accent-deep: var(--coral-700);
  --page-accent-wash: rgba(196, 97, 82, 0.12);

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --dur-fast: 120ms;
  --dur-base: 220ms;
  --dur-slow: 320ms;
}
